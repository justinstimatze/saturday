#!/usr/bin/env bash
# saturday-stack — start (or attach) a 3-pane tmux session running the full
# Saturday stack: watcher, mayor (audio-sock mode), audio sidecar.
#
# Idempotent: re-running attaches the existing session if alive. Each pane
# stays open after its process exits so you can read the failure output —
# `tmux respawn-pane` to restart in place, or `tmux kill-session -t
# saturday-stack` to nuke the whole thing and start fresh.
#
# Usage:
#   saturday-stack
#
# Env vars (optional):
#   SATURDAY_DIR  default $HOME/Documents/saturday — repo root, must contain
#                 saturday-audio/.venv
#   SOCK          default /tmp/saturday-audio.sock — mayor↔audio Unix socket
#   AUDIO_VENV    default $SATURDAY_DIR/saturday-audio/.venv
#   DRIVE_FOLDER_ID       required — the Drive folder Claude's voice-mode
#                         connector writes notes to (saturday-backend's
#                         phone-voice relay leg; see saturday-backend/README.md
#                         for the one-time Google Cloud / --drive-login setup)
#   BACKEND_POLL_INTERVAL default 5s — how often saturday-backend polls Drive

set -euo pipefail

SESSION="saturday-stack"
SOCK="${SOCK:-/tmp/saturday-audio.sock}"
SATURDAY_DIR="${SATURDAY_DIR:-$HOME/Documents/saturday}"
MAYOR_DIR="$SATURDAY_DIR/saturday-mayor"
AUDIO_DIR="$SATURDAY_DIR/saturday-audio"
AUDIO_VENV="${AUDIO_VENV:-$AUDIO_DIR/.venv}"

# V0.2.6: watcher runs headless (no pane). Logs and pidfile follow XDG.
XDG_STATE_HOME_RESOLVED="${XDG_STATE_HOME:-$HOME/.local/state}"
XDG_RUNTIME_DIR_RESOLVED="${XDG_RUNTIME_DIR:-/tmp}"
WATCHER_LOG="$XDG_STATE_HOME_RESOLVED/saturday/watcher.log"
WATCHER_PIDFILE="${TMPDIR:-/tmp}/saturday-stack-watcher.pid"
# Must match saturday-audio's DEFAULT_PIDFILE — the client-detached tmux
# hook below and mayor's watchdog both read this.
AUDIO_PIDFILE="$XDG_RUNTIME_DIR_RESOLVED/saturday-audio.pid"

# saturday-stage runs headless too, same shape as watcher — window
# choreography sidecar mayor dials as a client for focus/restore commands.
STAGE_SOCK="${STAGE_SOCK:-/tmp/saturday-stage.sock}"
STAGE_LOG="$XDG_STATE_HOME_RESOLVED/saturday/stage.log"
STAGE_PIDFILE="${TMPDIR:-/tmp}/saturday-stack-stage.pid"

# Headless backend, same shape as watcher/stage — Drive-relay poller for
# phone voice mode (SATURDAY-VOICE-NATIVE.md §2). No sane default for
# DRIVE_FOLDER_ID — it's the user's own private Drive folder id, not
# something to bake into a tracked script. Required, hard-fail if unset.
DRIVE_FOLDER_ID="${DRIVE_FOLDER_ID:-}"
BACKEND_POLL_INTERVAL="${BACKEND_POLL_INTERVAL:-5s}"
BACKEND_LOG="$XDG_STATE_HOME_RESOLVED/saturday/backend.log"
BACKEND_PIDFILE="${TMPDIR:-/tmp}/saturday-stack-backend.pid"

# Headless saturday-voice — talks to a rented moshi-server pod directly
# (see orchestrator/, moshiclient/, saturday-voice/). Unlike backend's
# DRIVE_FOLDER_ID (a one-time OAuth setup), SATURDAY_VOICE_STT_URL points
# at an EPHEMERAL rented pod's subdomain that changes every time a new pod
# is started — most sessions won't have one running at all. So this leg is
# opt-in, not hard-fail: unset means "skip it, log why," not "abort the
# whole stack."
SATURDAY_VOICE_STT_URL="${SATURDAY_VOICE_STT_URL:-}"
SATURDAY_VOICE_TTS_URL="${SATURDAY_VOICE_TTS_URL:-}"
SATURDAY_VOICE_AUTH_TOKEN="${SATURDAY_VOICE_AUTH_TOKEN:-}"
SATURDAY_VOICE_PORT="${SATURDAY_VOICE_PORT:-8080}"
VOICE_LOG="$XDG_STATE_HOME_RESOLVED/saturday/voice.log"
VOICE_PIDFILE="${TMPDIR:-/tmp}/saturday-stack-voice.pid"

# check_audio_venv — verify saturday-audio/.venv is usable. Two failure
# modes have bitten us in practice:
#
# 1. Python-version drift. venv was built against python3.13, the OS
#    upgraded to 3.14, the venv's own python binary now can't find its
#    site-packages (loads /usr/lib/python3.14/* stdlib instead of the
#    site-packages under lib/python3.13/). Every import fails.
# 2. Corruption / partial install. venv exists but `pip` or `numpy`
#    aren't importable — e.g. install got interrupted.
#
# On failure, print the exact repair command. `saturday-stack
# repair-audio` runs it non-interactively.
check_audio_venv() {
    if [ ! -f "$AUDIO_VENV/bin/activate" ]; then
        return 2  # missing entirely — caller handles
    fi
    local venv_py="$AUDIO_VENV/pyvenv.cfg"
    if [ -f "$venv_py" ]; then
        local venv_version
        venv_version="$(sed -n 's/^version[[:space:]]*=[[:space:]]*\(.*\)$/\1/p' "$venv_py" | head -n1 | tr -d '[:space:]')"
        local sys_version
        sys_version="$(python3 -c 'import sys; print("%d.%d.%d" % sys.version_info[:3])' 2>/dev/null || echo unknown)"
        if [ -n "$venv_version" ] && [ "$sys_version" != "unknown" ]; then
            local venv_minor="${venv_version%.*}"
            local sys_minor="${sys_version%.*}"
            if [ "$venv_minor" != "$sys_minor" ]; then
                echo "saturday-stack: audio venv Python drift — venv was built for $venv_version, system is $sys_version." >&2
                echo "  Rebuild:  saturday-stack repair-audio" >&2
                return 1
            fi
        fi
    fi
    # Smoke import — catches corruption even when versions match.
    if ! "$AUDIO_VENV/bin/python" -c 'import numpy, sounddevice, faster_whisper' 2>/dev/null; then
        echo "saturday-stack: audio venv exists but a smoke import failed (numpy/sounddevice/faster_whisper missing)." >&2
        echo "  Rebuild:  saturday-stack repair-audio" >&2
        return 1
    fi
    return 0
}

# repair_audio_venv — rebuild the audio venv from scratch. Long: pulls
# torch + faster-whisper + kokoro-onnx (~3-5 GB). Idempotent.
repair_audio_venv() {
    if [ ! -d "$AUDIO_DIR" ]; then
        echo "saturday-stack: audio dir missing: $AUDIO_DIR" >&2
        return 1
    fi
    if [ ! -f "$AUDIO_DIR/requirements.txt" ]; then
        echo "saturday-stack: no requirements.txt at $AUDIO_DIR/requirements.txt" >&2
        return 1
    fi
    echo "saturday-stack: rebuilding audio venv at $AUDIO_VENV (this may take several minutes)"
    rm -rf "$AUDIO_VENV"
    python3 -m venv "$AUDIO_VENV"
    "$AUDIO_VENV/bin/pip" install --upgrade pip wheel setuptools
    "$AUDIO_VENV/bin/pip" install -r "$AUDIO_DIR/requirements.txt"
    echo "saturday-stack: audio venv rebuilt."
}

# Subcommands: `stop` / `down` kills the session (tearing down all panes via
# SIGHUP, which mayor/watcher/audio's signal handlers clean up cleanly).
case "${1:-}" in
    repair-audio)
        repair_audio_venv
        exit $?
        ;;
    doctor)
        rc=0
        if ! command -v tmux >/dev/null 2>&1; then
            echo "saturday-stack: tmux missing (apt install tmux)" >&2; rc=1
        fi
        for bin in saturday-watcher saturday-mayor saturday-stage saturday-thinking saturday-backend; do
            if ! command -v "$bin" >/dev/null 2>&1 && [ ! -x "$HOME/go/bin/$bin" ]; then
                echo "saturday-stack: $bin not found on PATH or ~/go/bin" >&2; rc=1
            fi
        done
        if [ -z "$DRIVE_FOLDER_ID" ]; then
            echo "saturday-stack: DRIVE_FOLDER_ID not set — backend leg won't start (export it, see saturday-backend/README.md)" >&2
        fi
        if ! command -v saturday-voice >/dev/null 2>&1 && [ ! -x "$HOME/go/bin/saturday-voice" ]; then
            echo "saturday-stack: saturday-voice not found on PATH or ~/go/bin — that leg is opt-in anyway, not a hard failure" >&2
        elif [ -z "$SATURDAY_VOICE_STT_URL" ]; then
            echo "saturday-stack: SATURDAY_VOICE_STT_URL not set — saturday-voice leg won't start this session (expected unless a moshi-server pod is currently rented)"
        fi
        if [ ! -d "$AUDIO_DIR" ]; then
            echo "saturday-stack: audio dir missing: $AUDIO_DIR" >&2; rc=1
        elif [ ! -f "$AUDIO_VENV/bin/activate" ]; then
            echo "saturday-stack: audio venv missing — saturday-stack repair-audio" >&2; rc=1
        else
            check_audio_venv || rc=1
        fi
        # Live-session checks: the client-detached hook is only installed at
        # launch time (see the tmux set-hook call near the bottom of this
        # script), so there's nothing to verify before saturday-stack has
        # ever been started this boot. Skip silently rather than failing a
        # pre-launch doctor run for a hook that hasn't been armed yet.
        if tmux has-session -t "$SESSION" 2>/dev/null; then
            if ! tmux show-hooks -t "$SESSION" 2>/dev/null | grep -q '^client-detached'; then
                echo "saturday-stack: client-detached hook not set on running session $SESSION — SIGUSR1 force-mute won't fire on a stealth tmux disconnect (kill and relaunch saturday-stack to re-arm it)" >&2
                rc=1
            fi
            if ! [ -f "$AUDIO_PIDFILE" ] || ! kill -0 "$(cat "$AUDIO_PIDFILE" 2>/dev/null)" 2>/dev/null; then
                echo "saturday-stack: audio pidfile missing or stale at $AUDIO_PIDFILE — mayor's watchdog and the client-detached hook can't force-mute without it" >&2
                rc=1
            fi
        fi
        [ $rc -eq 0 ] && echo "saturday-stack: doctor OK."
        exit $rc
        ;;
    stop|down|kill)
        if tmux has-session -t "$SESSION" 2>/dev/null; then
            tmux kill-session -t "$SESSION"
            echo "saturday-stack: session killed."
        else
            echo "saturday-stack: no session running."
        fi
        # Kill headless watcher (V0.2.6 — watcher no longer in a pane).
        if [ -f "$WATCHER_PIDFILE" ]; then
            WPID=$(cat "$WATCHER_PIDFILE" 2>/dev/null)
            if [ -n "$WPID" ] && kill -0 "$WPID" 2>/dev/null; then
                kill "$WPID" 2>/dev/null && echo "saturday-stack: watcher (pid $WPID) killed."
            fi
            rm -f "$WATCHER_PIDFILE"
        fi
        # Kill headless stage (same shape as watcher above).
        if [ -f "$STAGE_PIDFILE" ]; then
            SPID=$(cat "$STAGE_PIDFILE" 2>/dev/null)
            if [ -n "$SPID" ] && kill -0 "$SPID" 2>/dev/null; then
                kill "$SPID" 2>/dev/null && echo "saturday-stack: stage (pid $SPID) killed."
            fi
            rm -f "$STAGE_PIDFILE"
        fi
        # Kill headless backend (same shape as watcher/stage above).
        if [ -f "$BACKEND_PIDFILE" ]; then
            BPID=$(cat "$BACKEND_PIDFILE" 2>/dev/null)
            if [ -n "$BPID" ] && kill -0 "$BPID" 2>/dev/null; then
                kill "$BPID" 2>/dev/null && echo "saturday-stack: backend (pid $BPID) killed."
            fi
            rm -f "$BACKEND_PIDFILE"
        fi
        # Kill headless saturday-voice, if it was started (opt-in leg).
        if [ -f "$VOICE_PIDFILE" ]; then
            VPID=$(cat "$VOICE_PIDFILE" 2>/dev/null)
            if [ -n "$VPID" ] && kill -0 "$VPID" 2>/dev/null; then
                kill "$VPID" 2>/dev/null && echo "saturday-stack: saturday-voice (pid $VPID) killed."
            fi
            rm -f "$VOICE_PIDFILE"
        fi
        exit 0
        ;;
    status)
        if tmux has-session -t "$SESSION" 2>/dev/null; then
            tmux list-panes -t "$SESSION" -F '#{pane_index} #{pane_pid} #{pane_current_command}'
        else
            echo "saturday-stack: not running."
            exit 1
        fi
        exit 0
        ;;
esac

if [ -n "${TMUX:-}" ]; then
    echo "saturday-stack: already inside tmux. Open a fresh terminal." >&2
    exit 1
fi

if ! command -v tmux >/dev/null 2>&1; then
    echo "saturday-stack: tmux not installed (apt install tmux)." >&2
    exit 1
fi

# If session exists, just reattach.
if tmux has-session -t "$SESSION" 2>/dev/null; then
    exec tmux attach-session -t "$SESSION"
fi

# Sanity-check the audio sidecar layout before constructing the session.
# Resolve XDG config home (override-friendly).
XDG_CONFIG_HOME_RESOLVED="${XDG_CONFIG_HOME:-$HOME/.config}"
SATURDAY_CONFIG="$XDG_CONFIG_HOME_RESOLVED/saturday/config"

# One-time migration: if XDG config doesn't exist yet but a legacy
# saturday-mayor/.env does, copy it across. Idempotent — only runs when
# the destination is missing.
if [ ! -f "$SATURDAY_CONFIG" ] && [ -f "$MAYOR_DIR/.env" ]; then
    mkdir -p "$(dirname "$SATURDAY_CONFIG")"
    cp "$MAYOR_DIR/.env" "$SATURDAY_CONFIG"
    echo "saturday-stack: migrated $MAYOR_DIR/.env → $SATURDAY_CONFIG"
fi

if [ ! -f "$SATURDAY_CONFIG" ]; then
    echo "saturday-stack: no Saturday config found." >&2
    echo "  Create $SATURDAY_CONFIG with your Anthropic key:" >&2
    echo "    mkdir -p $(dirname "$SATURDAY_CONFIG")" >&2
    echo "    echo 'ANTHROPIC_API_KEY=sk-...' > $SATURDAY_CONFIG" >&2
    exit 1
fi
if [ ! -d "$AUDIO_DIR" ]; then
    echo "saturday-stack: audio dir missing: $AUDIO_DIR" >&2
    echo "  set SATURDAY_DIR if the repo is elsewhere." >&2
    exit 1
fi
if [ ! -f "$AUDIO_VENV/bin/activate" ]; then
    echo "saturday-stack: audio venv missing: $AUDIO_VENV/bin/activate" >&2
    echo "  Rebuild:  saturday-stack repair-audio" >&2
    exit 1
fi
# Verify the venv actually works before we try to start the audio pane —
# a broken venv (Python drift, missing packages) would otherwise just
# print a stack trace inside the audio pane and die.
if ! check_audio_venv; then
    exit 1
fi
for bin in saturday-watcher saturday-mayor saturday-stage saturday-thinking saturday-backend; do
    if ! command -v "$bin" >/dev/null 2>&1 && [ ! -x "$HOME/go/bin/$bin" ]; then
        echo "saturday-stack: $bin not found on PATH or in ~/go/bin" >&2
        exit 1
    fi
done
if [ -z "$DRIVE_FOLDER_ID" ]; then
    echo "saturday-stack: DRIVE_FOLDER_ID not set." >&2
    echo "  export DRIVE_FOLDER_ID=<id of the Drive folder Claude's voice-mode connector writes notes to>" >&2
    echo "  (one-time Google Cloud / --drive-login setup: saturday-backend/README.md)" >&2
    exit 1
fi

# V0.2.6 layout: mayor takes the big left column ("most interesting and
# relevant log"); right column splits into thinking (top, FUI cognitive-state
# render) and audio (bottom, FUI spinner + transcripts). Watcher runs
# headless — its log noise wasn't pulling its weight in a pane.
#
#   ┌─────────────────┬──────────────┐
#   │                 │   thinking   │
#   │     mayor       │   (TUI)      │
#   │   (logs/errs)   ├──────────────┤
#   │   biggest L     │    audio     │
#   │                 │    (FUI)     │
#   └─────────────────┴──────────────┘
#
# Pane 0 = mayor (left). split-window -h adds the right column starting as
# thinking; split-window -v then puts audio below thinking. main-vertical
# layout sizes the left pane wider via main-pane-width.

# Headless watcher first — mayor needs the watcher socket up to route.
mkdir -p "$(dirname "$WATCHER_LOG")"
~/go/bin/saturday-watcher >> "$WATCHER_LOG" 2>&1 &
echo $! > "$WATCHER_PIDFILE"
echo "saturday-stack: watcher running headless (pid $(cat "$WATCHER_PIDFILE")), log → $WATCHER_LOG"

# Headless stage — window choreography sidecar. No ordering dependency on
# mayor (runStageClient reconnects with backoff regardless), but launched
# alongside watcher so "headless services first" stays one visible block.
mkdir -p "$(dirname "$STAGE_LOG")"
~/go/bin/saturday-stage --sock "$STAGE_SOCK" >> "$STAGE_LOG" 2>&1 &
echo $! > "$STAGE_PIDFILE"
echo "saturday-stack: stage running headless (pid $(cat "$STAGE_PIDFILE")), log → $STAGE_LOG"

# Headless backend — phone-voice Drive relay. Same "headless services first"
# block as watcher/stage; only needs the watcher socket, no ordering
# dependency on mayor.
mkdir -p "$(dirname "$BACKEND_LOG")"
~/go/bin/saturday-backend --drive-folder-id "$DRIVE_FOLDER_ID" --poll-interval "$BACKEND_POLL_INTERVAL" --stage-sock "$STAGE_SOCK" --stage-tile >> "$BACKEND_LOG" 2>&1 &
echo $! > "$BACKEND_PIDFILE"
echo "saturday-stack: backend running headless (pid $(cat "$BACKEND_PIDFILE")), log → $BACKEND_LOG"

# Headless saturday-voice — opt-in (see the var block above for why this
# is the one leg that doesn't hard-fail the stack when unset).
if [ -n "$SATURDAY_VOICE_STT_URL" ] && [ -n "$SATURDAY_VOICE_TTS_URL" ] && [ -n "$SATURDAY_VOICE_AUTH_TOKEN" ]; then
    mkdir -p "$(dirname "$VOICE_LOG")"
    ~/go/bin/saturday-voice \
        --port "$SATURDAY_VOICE_PORT" \
        --auth-token "$SATURDAY_VOICE_AUTH_TOKEN" \
        --moshi-stt-url "$SATURDAY_VOICE_STT_URL" \
        --moshi-tts-url "$SATURDAY_VOICE_TTS_URL" \
        --stage-sock "$STAGE_SOCK" --stage-tile \
        >> "$VOICE_LOG" 2>&1 &
    echo $! > "$VOICE_PIDFILE"
    echo "saturday-stack: saturday-voice running headless (pid $(cat "$VOICE_PIDFILE")) on :$SATURDAY_VOICE_PORT, log → $VOICE_LOG"
elif [ -n "$SATURDAY_VOICE_STT_URL" ] || [ -n "$SATURDAY_VOICE_TTS_URL" ] || [ -n "$SATURDAY_VOICE_AUTH_TOKEN" ]; then
    echo "saturday-stack: saturday-voice skipped — SATURDAY_VOICE_STT_URL, SATURDAY_VOICE_TTS_URL, and SATURDAY_VOICE_AUTH_TOKEN must all be set together (some but not all are)." >&2
else
    echo "saturday-stack: saturday-voice skipped (SATURDAY_VOICE_STT_URL unset — no rented moshi-server pod configured this session)."
fi

tmux new-session -d -s "$SESSION" -n "stack" \
    "echo '[mayor]'; exec ~/go/bin/saturday-mayor --audio-sock '$SOCK' --stage-sock '$STAGE_SOCK' --stage-tile"

# Keep panes around after their process exits so failures are inspectable.
tmux set-option -t "$SESSION" remain-on-exit on

# Persistent help line at the bottom — new tmux users won't know how to leave
# the session otherwise. status-right is shown in every window of the session.
# Highlighted in yellow so it doesn't blend into the default status bar.
tmux set-option -t "$SESSION" status-right-length 90
tmux set-option -t "$SESSION" status-right \
    '#[fg=black,bg=yellow,bold] stop all: saturday-stack stop │ detach (keep running): Ctrl-b then d #[default]'

# Right column, top: thinking pane.
tmux split-window -t "${SESSION}:0" -h \
    "echo '[thinking]'; exec ~/go/bin/saturday-thinking"

# Right column, bottom: audio sidecar.
tmux split-window -t "${SESSION}:0" -v \
    "echo '[audio]'; cd '$AUDIO_DIR' && source '$AUDIO_VENV/bin/activate' && exec python main.py"

# main-vertical: pane 0 (mayor) becomes the main (left) pane, sized larger
# than the right column. main-pane-width controls left/right split.
tmux set-window-option -t "${SESSION}:0" main-pane-width 60%
tmux select-layout -t "${SESSION}:0" main-vertical
tmux select-pane -t "${SESSION}:0.2"  # focus audio pane (SPACEBAR mute + spinner)

# Safety: force-mute the audio sidecar when the last tmux client detaches.
# Open mic + no attached terminal is the failure mode this closes — the
# operator can't see or SPACEBAR the mute, and utterances would keep
# routing into whichever session the router picks. The hook fires
# SIGUSR1 (unconditional mute; no unmute pair — operator must SPACEBAR
# re-arm after reattaching). Mayor runs a redundant client-count
# watchdog too; this is just the fast path.
tmux set-hook -t "$SESSION" client-detached \
    "run-shell 'kill -USR1 \$(cat $AUDIO_PIDFILE 2>/dev/null) 2>/dev/null || true'"

# Attach only if invoked from a terminal. When run headless (e.g. from a
# script or a non-TTY environment), leave the session detached for the
# user to attach manually with `tmux attach -t saturday-stack`.
if [ -t 0 ] && [ -t 1 ]; then
    exec tmux attach-session -t "$SESSION"
else
    echo "saturday-stack: started detached. attach with: tmux attach -t $SESSION"
fi
