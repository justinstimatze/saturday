#!/usr/bin/env bash
# saturday-cockpit-boot-stub — per-role instrument pane for `saturday-cockpit
# --boot`'s staggered reveal. First positional arg is the pane label; every
# role ends in an ambient idle loop that `tmux respawn-pane -k` (or a
# session kill) terminates cleanly, so the real command can swap in.
#
# ONE COCKPIT MADE OF DIFFERENT INSTRUMENTS, not N copies of one animation.
# Steel Battalion never shows two cockpits side-by-side, so "checklist
# identical across units" was never tested against a multi-pane view; a tmux
# cockpit tests it instantly and it fails. The differentiation below is
# grounded three ways — provenance marked per feature (full rationale in the
# boot-redesign design notes / ROADMAP entry):
#   [SB-frames]  frame-verified from source footage
#                (AEUNbdsl4Dk 1st-gen VT startup; wY8yXkpXuf4 controller cam)
#   [SB-manual]  the Capcom manual's documented startup sequence
#   [FUI-lit]    lucida's design-references.md / eDEX-UI notes — technique
#                only, never palette (cross-theme bleed is that doc's own
#                named failure mode)
#   [recall]     the user's own memory of the game, honored as direction
#
# Roles (`--role`):
#   main  — the center display, hero treatment [FUI-lit: Hojlund's hero/
#           ambient split]. Its real arc [SB-frames, 0:08→0:25]:
#           dark → 5-bar Primary Systems Status Check → text OS boot
#           ("STARTING OS / EXCLUSIVE OPERATING SYSTEM FOR VT") → dense
#           scrolling INPUT/OUTPUT log ("INPUT ALL CLEAR", "OUTPUT
#           MU-SYSTEM CHECK") → live feed + corner readouts + "WORK 100%"
#           confirm. Here the live feed is literally the respawned claude.
#   gauge — analog dial: needle sweeps out/back in red (calibration),
#           settles, confirms blue [SB-frames: bottom dial clusters].
#   scope — scrolling telemetry feed with red CHK → blue ACK tokens
#           [SB-frames: the center display's own INPUT/OUTPUT log phase,
#           reassigned to a peripheral as a continuous feed].
#   strip — readout cluster: label/value pairs populate one at a time, with
#           a chase-lamp row [SB-frames, controller cam: the center block's
#           red button row visibly CYCLES during the light show — a chase,
#           not steady-on; this is the button-bank instrument].
#   radar — nav sub-display: bordered grid, sweep line reveals red blips,
#           second pass acquires them blue, NAV LOCK [SB-frames: the small
#           top nav-map monitor with its lamp column].
#
# Peripheral roles are LIT FROM FRAME ONE — no dark stage [SB-frames: the
# bottom dashboard dials are lit continuously in every clip; only the center
# display and corner readouts blackout-stage]. Only `main` gets the dark
# cockpit.
#
# Accent language:
#   - smooth eased fills/sweeps = testing (red), per-element, staggered
#     [SB-frames: LoC ~3s progressive fill; controller LEDs red-in-test]
#   - ONE discrete reverse-video double-blink per instrument at its confirm
#     moment (NOMINAL / CALIBRATED / LINK ESTABLISHED / CORE STABLE /
#     NAV LOCK). Blinking-lamp behavior is [SB-frames]-verified on the
#     controller (lamps turn on and off at ~1-2s cadence). main alone gets
#     a second flash at WORK 100% — the hero exception [FUI-lit].
#   - ambient idle motion after confirm — needle micro-wobble, heartbeat
#     feed lines, ticking values, pulsing blips [FUI-lit: "workshop
#     monitors never freeze"; not in SB footage — invented flourish].
#   - edge-telemetry micro-readout in each peripheral's top-right corner
#     [SB-frames: stacked numeric edge readouts light during boot;
#     FUI-lit: edge telemetry density].
# Palette stays red-31 testing / blue-34 confirmed + dim/bold ONLY. The
# in-game HUD is green; importing it would be cross-theme bleed [FUI-lit],
# and red/blue is this ritual's established language [SB-frames: controller
# LED two-phase color].
#
# Usage: saturday-cockpit-boot-stub [label]
#          [--role main|gauge|scope|strip|radar] [--inst NAME] [--delay MS]
#          [--window MS] [--fast] [--dark MS] [--sync CHANNEL]
#   --inst NAME   peripheral's subsystem name (REACTOR/SERVOS/OPTICS/COMMS/
#                 MANIPULATOR) — the checklist's 5 subsystems ARE the
#                 peripheral instruments, one each.
#   --delay MS    main: extra dark hold. peripherals: lit-idle hold before
#                 the test starts (covers the pane's grow window).
#   --fast        ~1s snap pacing (original-SB) instead of the ~3s LoC fill.
#   --sync CHAN   main only: block the dark hold on `tmux wait-for CHAN`.
# Not meant to be run standalone for any real purpose.
set -eu

label="session"
role="main"
inst=""
delay_ms=0
window_ms=3000
dark_ms=400
sync_chan=""

while [ "$#" -gt 0 ]; do
    case "$1" in
        --role)   role="$2";      shift 2 ;;
        --inst)   inst="$2";      shift 2 ;;
        --delay)  delay_ms="$2";  shift 2 ;;
        --window) window_ms="$2"; shift 2 ;;
        --dark)   dark_ms="$2";   shift 2 ;;
        --sync)   sync_chan="$2"; shift 2 ;;
        --fast)   window_ms=900;  shift ;;
        *)        label="$1";     shift ;;
    esac
done

esc=$'\033'
dim="${esc}[2m"; red="${esc}[31m"; blue="${esc}[34m"
bold="${esc}[1m"; reset="${esc}[0m"
hide="${esc}[?25l"; show="${esc}[?25h"
# Signals exit EXPLICITLY: a plain `trap 'printf …' HUP` would HANDLE the
# hangup a session kill sends and leave the ambient idle loop running until
# its next failed write — with an explicit exit the pane process dies at
# once, and the EXIT trap still restores the cursor (|| true: the pty may
# already be gone by then).
trap 'printf %s "$show$reset" 2>/dev/null || true' EXIT
trap 'exit 129' INT TERM HUP

if [ -n "${EPOCHREALTIME:-}" ]; then
    now_ms() { local t="${EPOCHREALTIME/./}"; echo $(( t / 1000 )); }
else
    now_ms() { date +%s%3N; }
fi
msleep() { sleep "$(( $1 / 1000 )).$(printf '%03d' $(( $1 % 1000 )))"; }
sc() { echo $(( $1 * window_ms / 3000 )); }   # scale a duration to --window

# trace <event> — optional timing log (SATURDAY_BOOT_TRACE=<file>) used by
# the boot-redesign verification harness to count draws landing during an
# active resize. No-op unless the env var is set.
trace() {
    if [ -n "${SATURDAY_BOOT_TRACE:-}" ]; then
        echo "$$ $1 $(now_ms)" >> "$SATURDAY_BOOT_TRACE" 2>/dev/null || true
    fi
}

# resize_hold — THE INVARIANT: a pane's content may animate, or its boundary
# may move, never both at once. WINCH doubles as the pause signal: on any
# resize the draw loops freeze on their last frame and only resume once no
# further WINCH has arrived for RESIZE_QUIET_MS — a real settle, not the
# ~35ms gap between two eased grow steps. The `relayout` full static redraw
# then repaints whatever the mid-resize reflow garbled. SATURDAY_BOOT_NOHOLD
# =1 disables the gate (measurement escape hatch for the before/after count).
RESIZE_QUIET_MS=250
resize_hold() {
    if [ -n "${SATURDAY_BOOT_NOHOLD:-}" ]; then return 0; fi
    local since
    while :; do
        [ "$winch_ms" -eq 0 ] && return 0
        since=$(( $(now_ms) - winch_ms ))
        [ "$since" -ge "$RESIZE_QUIET_MS" ] && return 0
        msleep 40
    done
}
frame_gate() { resize_hold; trace draw; }   # once per animation-loop frame

# Geometry is re-measured on every SIGWINCH: a grow-split pane is born a
# sliver, and a LATER pane's grow can briefly squeeze this one — both
# observed live to lock wrong geometry in when measured only once.
relayout=0
winch_ms=0
trap 'relayout=1; winch_ms=$(now_ms); trace winch' WINCH
measure() {
    cols=$( (tput cols) 2>/dev/null || echo 80 );  [ -n "$cols" ] || cols=80
    lines=$( (tput lines) 2>/dev/null || echo 24 ); [ -n "$lines" ] || lines=24
}

# flash2 <row> <col> <plain-text> — the confirm accent: two discrete
# reverse-video blinks. Caller prints the colored final state afterwards.
flash2() {
    local r="$1" c="$2" t="$3" _i
    resize_hold   # confirm blinks are draws too — same invariant
    for _i in 1 2; do
        printf '\033[%d;%dH\033[7m%s\033[0m' "$r" "$c" "$t"; msleep 70
        printf '\033[%d;%dH%s\033[K' "$r" "$c" "$t"; msleep 70
    done
}

# edge_tick — peripheral top-right micro-readout [SB-frames edge readouts +
# FUI-lit edge telemetry]. Dim, tiny, alive.
edge_tick() {
    if [ "$cols" -ge 20 ]; then   # if/fi, not `[ ] &&` — set -e + guard-as-
        printf '\033[1;%dH%s%03d%s' "$(( cols - 4 ))" "$dim" "$(( RANDOM % 1000 ))" "$reset"
    fi                            # last-line killed a function once already
}

subsys_word() {
    case "$1" in
        REACTOR) echo OUTPUT ;;  SERVOS) echo TORQUE ;;  OPTICS) echo FOCUS ;;
        COMMS)   echo SIGNAL ;;  MANIPULATOR) echo GRIP ;;  *) echo TEST ;;
    esac
}

peri_header() {  # <title-suffix> — shared peripheral chrome, rows 2-3
    printf '%s\033[2J\033[H' "$hide"
    printf '\n  %s%s ─ %s%s\n  %s%s%s\n' \
        "$bold" "${inst:-$1}" "$1" "$reset" "$dim" "$label" "$reset"
}

# ============================= role: main ===================================
rows=(REACTOR SERVOS OPTICS COMMS MANIPULATOR)
offs_pm=(0 140 60 260 190)    # per-row offset, permille of window —
durs_pm=(740 610 830 550 690)  # staggered, deliberately unsorted (no sweep)

main_header() {
    measure
    bar_w=$(( cols - 38 ))
    [ "$bar_w" -gt 24 ] && bar_w=24
    [ "$bar_w" -lt 10 ] && bar_w=10
    tick=$(( bar_w * 70 / 100 ))   # the manual's ~70% clearance mark
    FULL=""; EMPTY=""
    for _ in $(seq "$bar_w"); do FULL+="█"; EMPTY+="░"; done
    printf '\033[2J\033[H'
    if [ "$lines" -ge 13 ]; then
        printf '\n  %s\n  %s\n' \
            "${bold}SATURDAY COCKPIT ─ PRIMARY SYSTEMS CHECK${reset}" \
            "${dim}${label}${reset}"
        bar_row=5; start_row=11
    else
        printf '  %s %s\n' \
            "${bold}SATURDAY ─ SYSTEMS CHECK${reset}" "${dim}${label}${reset}"
        bar_row=2; start_row=8
    fi
}

main_draw() {  # <t_ms> — checklist rows + START line for elapsed t
    local t="$1" frame="" i p q filled pct mark barc status fill empty tr
    all_done=1; all_clear=1
    for i in 0 1 2 3 4; do
        local off=$(( window_ms * ${offs_pm[$i]} / 1000 ))
        local dur=$(( window_ms * ${durs_pm[$i]} / 1000 ))
        p=$(( (t - off) * 1000 / dur ))
        [ "$p" -lt 0 ] && p=0; [ "$p" -gt 1000 ] && p=1000
        q=$(( p * (2000 - p) / 1000 ))       # quadratic ease-out — integer
        filled=$(( q * bar_w / 1000 ))       # cousin of stage's smoothdamp
        pct=$(( q / 10 ))
        if [ "$p" -ge 1000 ]; then
            mark="[${blue}OK${reset}]"; barc="$blue"; status="${blue}OK${reset}     "
        else
            all_done=0
            mark="[  ]"; barc="$red"; status="${red}TESTING${reset}"
        fi
        [ "$q" -lt 700 ] && all_clear=0
        fill="${FULL:0:$filled}"
        empty="${EMPTY:0:$(( bar_w - filled ))}"
        if [ "$p" -lt 1000 ] && [ "$filled" -lt "$tick" ]; then
            tr=$(( tick - filled ))
            empty="${empty:0:$tr}│${empty:$(( tr + 1 ))}"
        fi
        frame+=$(printf '\033[%d;1H  %s %-12s %s%s%s%s%s %3d%%  %s\033[K' \
            "$(( bar_row + i ))" "$mark" "${rows[$i]}" \
            "$barc" "$fill" "$reset$dim" "$empty" "$reset" "$pct" "$status")
    done
    if [ "$all_done" -eq 1 ]; then
        frame+=$(printf '\033[%d;1H\033[K' "$start_row")
    elif [ "$all_clear" -eq 1 ]; then
        frame+=$(printf '\033[%d;1H  %s\033[K' "$start_row" \
            "${bold}${blue}START ▸ READY${reset}")
    else
        frame+=$(printf '\033[%d;1H  %s\033[K' "$start_row" \
            "${dim}START ─ locked · meters must clear 70%%${reset}")
    fi
    printf '%s' "$frame"
}

# main_oslog — the center display's text-boot phase [SB-frames 0:17-0:19]:
# short OS banner typed line by line, then a fast scrolling INPUT/OUTPUT
# burst. Tokens "STARTING OS" / "EXCLUSIVE OPERATING SYSTEM" / "INPUT ALL
# CLEAR" / "OUTPUT MU-SYSTEM CHECK" are read from frames (320x240 source —
# close paraphrase where pixels were ambiguous, not verbatim OCR).
main_oslog() {
    local buf=() cap first nshow i ln n j
    printf '\033[2J\033[H'
    printf '\n  %sSATURDAY VT-OS%s\n' "$bold" "$reset"
    local banner=(
        "  STARTING OS"
        "  EXCLUSIVE OPERATING SYSTEM ─ $(echo "$label" | tr '[:lower:]' '[:upper:]')"
        "  STATUS INFORMATION"
    )
    for i in 0 1 2; do
        printf '\033[%d;1H%s%s%s' "$(( 4 + i ))" "$dim" "${banner[$i]}" "$reset"
        msleep "$(sc 220)"
    done
    cap=$(( lines - 9 )); [ "$cap" -lt 3 ] && cap=3; [ "$cap" -gt 10 ] && cap=10
    n=14
    for (( i = 0; i < n; i++ )); do
        frame_gate
        if [ "$relayout" -eq 1 ]; then relayout=0; measure; fi
        case "$i" in
            8)  printf -v ln '  %sINPUT ALL CLEAR%s' "$blue" "$reset" ;;
            11) printf -v ln '  %sOUTPUT MU-SYSTEM CHECK%s' "$dim" "$reset" ;;
            13) printf -v ln '  %sSQI-EWE SYSTEM LOADED%s' "$blue" "$reset" ;;
            *)  printf -v ln '  %sINPUT-%03d %04X-%06d%s' "$dim" \
                    "$(( i + 7 ))" "$(( RANDOM % 65536 ))" "$(( RANDOM % 1000000 ))" "$reset" ;;
        esac
        buf+=("$ln")
        nshow=${#buf[@]}; first=0
        [ "$nshow" -gt "$cap" ] && { first=$(( nshow - cap )); nshow="$cap"; }
        for (( j = 0; j < nshow; j++ )); do
            printf '\033[%d;1H%s\033[K' "$(( 8 + j ))" "${buf[$(( first + j ))]}"
        done
        msleep "$(sc 85)"
    done
    msleep "$(sc 300)"
}

# feed_frame <populated 0..4> — the center display's final state before the
# real feed: big label, corner readout boxes appearing one at a time
# [SB-frames: corner/edge readouts light during the boot-text phase, center
# swaps to live exterior feed]. Full-redraw so it also serves relayouts.
feed_frame() {
    local pop="$1" mid c t1 t2
    measure
    printf '\033[2J\033[H'
    mid=$(( lines / 2 )); [ "$mid" -lt 3 ] && mid=3
    t1="$label"
    c=$(( (cols - ${#t1}) / 2 )); [ "$c" -lt 1 ] && c=1
    printf '\033[%d;%dH%s%s%s' "$(( mid - 1 ))" "$c" "$bold" "$t1" "$reset"
    t2="AWAITING LIVE FEED"
    c=$(( (cols - ${#t2}) / 2 )); [ "$c" -lt 1 ] && c=1
    printf '\033[%d;%dH%s%s%s' "$(( mid + 1 ))" "$c" "$dim" "$t2" "$reset"
    [ "$pop" -ge 1 ] && printf '\033[1;2H%s[%s%s%s]%s' "$dim" "$reset$blue" "SYS OK" "$reset$dim" "$reset"
    [ "$pop" -ge 2 ] && printf '\033[1;%dH%s[%s%s%s]%s' "$(( cols - 9 ))" "$dim" "$reset$blue" "LINK ▲" "$reset$dim" "$reset"
    [ "$pop" -ge 3 ] && printf '\033[%d;2H%s[%s%s%s]%s' "$lines" "$dim" "$reset$blue" "PWR ▮▮▮" "$reset$dim" "$reset"
    [ "$pop" -ge 4 ] && printf '\033[%d;%dH%s[%s%s%s]%s' "$lines" "$(( cols - 10 ))" "$dim" "$reset$blue" "FEED ●" "$reset$dim" "$reset"
    return 0   # guard-as-last-line + set -e killed the stub for pop<4 —
}              # observed live: main pane died right after its first frame

run_main() {
    # stage 1: dark cockpit — only the center display blackout-stages
    printf '%s\033[2J\033[H' "$hide"
    printf '\033[2;3H%s·%s' "$dim" "$reset"
    if [ -n "$sync_chan" ] && [ -n "${TMUX:-}" ]; then
        timeout 10 tmux wait-for "$sync_chan" 2>/dev/null || true
    else
        msleep "$dark_ms"
    fi
    [ "$delay_ms" -gt 0 ] && msleep "$delay_ms"

    # stage 2: Primary Systems Status Check [SB-frames 0:14, SB-manual 70%]
    main_header
    local t0; t0=$(now_ms)
    all_done=0; all_clear=0
    while :; do
        frame_gate
        if [ "$relayout" -eq 1 ]; then relayout=0; main_header; fi
        main_draw "$(( $(now_ms) - t0 ))"
        [ "$all_done" -eq 1 ] && break
        msleep 30
    done
    flash2 "$start_row" 3 "START ▸ ALL SYSTEMS NOMINAL"
    printf '\033[%d;1H  %s\033[K' "$start_row" \
        "${bold}${blue}START ▸ ALL SYSTEMS NOMINAL${reset}"
    msleep "$(sc 450)"

    # stage 3: VT-OS text boot + INPUT/OUTPUT log [SB-frames 0:17-0:19]
    main_oslog

    # stage 4: live-feed frame, corner readouts, WORK confirm [SB-frames
    # 0:22-0:25 "O.K WORK 100%"] — the hero's second flash [FUI-lit]
    local pop c t2
    for pop in 1 2 3 4; do
        frame_gate
        feed_frame "$pop"
        msleep "$(sc 320)"
    done
    t2="WORK 100%"
    c=$(( (cols - ${#t2}) / 2 )); [ "$c" -lt 1 ] && c=1
    flash2 "$(( lines / 2 + 3 ))" "$c" "$t2"
    printf '\033[%d;%dH%s%s%s%s' "$(( lines / 2 + 3 ))" "$c" "$bold" "$blue" "$t2" "$reset"
    # arc complete — latch it on the pane so saturday-cockpit can hold the
    # addressed respawn until now (a pane option, not wait-for: an option
    # reads correctly whichever side gets there first, a wait-for signal
    # fired before its waiter arrives is silently dropped)
    if [ -n "${TMUX_PANE:-}" ]; then
        tmux set-option -p -t "$TMUX_PANE" @boot_main_done 1 2>/dev/null || true
    fi
    # idle: pulse the FEED corner until the respawn brings the real feed
    printf '%s' "$show"
    local on=1
    while :; do
        frame_gate
        if [ "$relayout" -eq 1 ]; then
            relayout=0; feed_frame 4
            printf '\033[%d;%dH%s%s%s%s' "$(( lines / 2 + 3 ))" "$c" "$bold" "$blue" "$t2" "$reset"
        fi
        if [ "$on" -eq 1 ]; then
            printf '\033[%d;%dH%s●%s' "$lines" "$(( cols - 4 ))" "$blue" "$reset"; on=0
        else
            printf '\033[%d;%dH%s·%s' "$lines" "$(( cols - 4 ))" "$dim" "$reset"; on=1
        fi
        msleep 600
    done
}

# ============================= role: gauge ==================================
run_gauge() {
    local name="${inst:-SERVOS}" sub tw trow t0 t seg segms pos idx track i
    sub=$(subsys_word "$name")
    gauge_static() {
        measure
        tw=$(( cols - 14 ))
        [ "$tw" -gt 50 ] && tw=50
        [ "$tw" -lt 12 ] && tw=12
        trow=$(( lines / 2 )); [ "$trow" -lt 5 ] && trow=5
        inst="$name" peri_header "$sub"
    }
    gauge_track() {  # <permille> <color> — needle on dial track
        local pm="$1" c="$2"
        idx=$(( pm * (tw - 1) / 1000 ))
        track=""
        for (( i = 0; i < tw; i++ )); do
            if [ "$i" -eq "$idx" ]; then track+="${reset}${c}◆${reset}${dim}"
            else track+="─"; fi
        done
        printf '\033[%d;1H    %s╶%s╴%s\033[K' "$trow" "$dim" "$track" "$reset"
        printf '\033[%d;1H    %s%s %3d%%%s\033[K' "$(( trow + 2 ))" \
            "$c" "$sub" "$(( pm / 10 ))" "$reset"
    }
    gauge_static                 # lit from frame one [SB-frames]
    [ "$delay_ms" -gt 0 ] && msleep "$delay_ms"

    segms=$(( window_ms * 8 / 30 ))   # three segments: out, back, seek
    t0=$(now_ms)
    while :; do
        frame_gate
        if [ "$relayout" -eq 1 ]; then relayout=0; gauge_static; fi
        t=$(( $(now_ms) - t0 ))
        seg=$(( t / segms ))
        [ "$seg" -ge 3 ] && break
        pos=$(( (t % segms) * 1000 / segms ))
        case "$seg" in
            1) pos=$(( 1000 - pos )) ;;
            2) pos=$(( pos * (2000 - pos) / 1000 ))
               pos=$(( pos * 820 / 1000 )) ;;
        esac
        gauge_track "$pos" "$red"
        edge_tick
        msleep 30
    done
    gauge_track 820 "$blue"
    flash2 "$(( trow + 3 ))" 5 "CALIBRATED"
    printf '\033[%d;5H%s%sCALIBRATED%s\033[K' "$(( trow + 3 ))" "$bold" "$blue" "$reset"
    printf '\033[%d;1H  %sSTANDBY%s\033[K%s' "$(( trow + 5 > lines ? lines : trow + 5 ))" "$dim" "$reset" "$show"
    # ambient idle: needle micro-wobble around its settled value [FUI-lit]
    local w=0
    while :; do
        frame_gate
        if [ "$relayout" -eq 1 ]; then
            relayout=0; gauge_static; gauge_track 820 "$blue"
            printf '\033[%d;5H%s%sCALIBRATED%s\033[K' "$(( trow + 3 ))" "$bold" "$blue" "$reset"
        fi
        if [ "$w" -eq 0 ]; then gauge_track 828 "$blue"; w=1
        else gauge_track 812 "$blue"; w=0; fi
        edge_tick
        msleep 700
    done
}

# ============================= role: scope ==================================
run_scope() {
    local name="${inst:-COMMS}" cap buf=() n t0 ln i j
    scope_static() {
        measure
        cap=$(( lines - 6 ))
        [ "$cap" -lt 3 ] && cap=3
        [ "$cap" -gt 12 ] && cap=12
        inst="$name" peri_header "TELEMETRY"
        printf '\033[4;1H  %slistening…%s\033[K' "$dim" "$reset"
    }
    scope_redraw() {
        local nshow=${#buf[@]} first=0
        [ "$nshow" -gt "$cap" ] && { first=$(( nshow - cap )); nshow="$cap"; }
        for (( j = 0; j < nshow; j++ )); do
            printf '\033[%d;1H%s\033[K' "$(( 5 + j ))" "${buf[$(( first + j ))]}"
        done
    }
    scope_static                 # lit from frame one [SB-frames]
    [ "$delay_ms" -gt 0 ] && msleep "$delay_ms"

    n=$(( window_ms * 22 / 3000 )); [ "$n" -lt 8 ] && n=8
    for (( i = 0; i < n; i++ )); do
        frame_gate
        if [ "$relayout" -eq 1 ]; then relayout=0; scope_static; fi
        printf -v ln '  %s▸ %04X%s %sCHK%s %sbus/%d rt=%02d%s' \
            "$dim" "$(( RANDOM % 65536 ))" "$reset" "$red" "$reset" \
            "$dim" "$(( RANDOM % 8 ))" "$(( RANDOM % 90 ))" "$reset"
        buf+=("$ln")
        scope_redraw
        edge_tick
        msleep 110
    done
    for i in 1 2 3; do
        frame_gate
        printf -v ln '  %s▸ ch/%d%s %sACK%s' "$dim" "$i" "$reset" "$blue" "$reset"
        buf+=("$ln")
        scope_redraw
        msleep 150
    done
    flash2 4 3 "LINK ESTABLISHED"
    printf '\033[4;3H%s%sLINK ESTABLISHED%s\033[K%s' "$bold" "$blue" "$reset" "$show"
    # ambient idle: heartbeat lines keep arriving, dim and slow [FUI-lit]
    while :; do
        frame_gate
        if [ "$relayout" -eq 1 ]; then
            relayout=0; scope_static; scope_redraw
            printf '\033[4;3H%s%sLINK ESTABLISHED%s\033[K' "$bold" "$blue" "$reset"
        fi
        printf -v ln '  %s▸ %04X ok%s' "$dim" "$(( RANDOM % 65536 ))" "$reset"
        buf+=("$ln")
        scope_redraw
        edge_tick
        msleep 1800
    done
}

# ============================= role: strip ==================================
run_strip() {
    local name="${inst:-REACTOR}" start_r nf i j r chase=0
    local fields=(PWR TEMP PSI AMP FREQ BUS)
    local finals=("98%" "341K" "12.4" "3.9A" "50Hz" "OK")
    local set_state=(0 0 0 0 0 0)
    strip_chase() {  # <mode: red-chase | blue-steady> — the button-bank lamp
        local lampline="" k   # row [SB-frames: center block's cycling reds]
        for k in 0 1 2 3 4; do
            if [ "$1" = "blue" ]; then lampline+="${blue}▮${reset} "
            elif [ "$k" -eq "$chase" ]; then lampline+="${red}▮${reset} "
            else lampline+="${dim}▯${reset} "; fi
        done
        printf '\033[%d;3H%s\033[K' "$(( start_r - 1 ))" "$lampline"
    }
    strip_static() {
        measure
        if [ "$lines" -ge 15 ]; then start_r=6; else start_r=5; fi
        nf=$(( lines - start_r - 3 ))
        [ "$nf" -gt 6 ] && nf=6
        [ "$nf" -lt 2 ] && nf=2
        inst="$name" peri_header "READOUT"
        for (( j = 0; j < nf; j++ )); do
            if [ "${set_state[$j]}" -eq 1 ]; then
                printf '\033[%d;1H  %-5s %s%s%s\033[K' "$(( start_r + j ))" \
                    "${fields[$j]}" "$blue" "${finals[$j]}" "$reset"
            else
                printf '\033[%d;1H  %-5s %s──%s\033[K' "$(( start_r + j ))" \
                    "${fields[$j]}" "$dim" "$reset"
            fi
        done
    }
    strip_static                 # lit from frame one [SB-frames]
    [ "$delay_ms" -gt 0 ] && msleep "$delay_ms"

    for (( i = 0; i < nf; i++ )); do
        frame_gate
        if [ "$relayout" -eq 1 ]; then relayout=0; strip_static; fi
        r=$(( start_r + i ))
        for j in 1 2 3; do   # red flicker while this readout tests
            chase=$(( (chase + 1) % 5 )); strip_chase red
            printf '\033[%d;1H  %-5s %s%02d%s\033[K' "$r" "${fields[$i]}" \
                "$red" "$(( RANDOM % 100 ))" "$reset"
            edge_tick
            msleep 60
        done
        set_state[$i]=1
        printf '\033[%d;1H  %-5s %s%s%s\033[K' "$r" "${fields[$i]}" \
            "$blue" "${finals[$i]}" "$reset"
        chase=$(( (chase + 1) % 5 )); strip_chase red
        msleep 160
    done
    strip_chase blue
    r=$(( start_r + nf + 1 ))
    flash2 "$r" 3 "CORE STABLE"
    printf '\033[%d;3H%s%sCORE STABLE%s\033[K%s' "$r" "$bold" "$blue" "$reset" "$show"
    # ambient idle: TEMP breathes between neighboring values [FUI-lit]
    local t_on=0
    while :; do
        frame_gate
        if [ "$relayout" -eq 1 ]; then
            relayout=0; strip_static; strip_chase blue
            printf '\033[%d;3H%s%sCORE STABLE%s\033[K' "$r" "$bold" "$blue" "$reset"
        fi
        if [ "$nf" -ge 2 ]; then
            if [ "$t_on" -eq 0 ]; then
                printf '\033[%d;1H  %-5s %s342K%s\033[K' "$(( start_r + 1 ))" "TEMP" "$blue" "$reset"; t_on=1
            else
                printf '\033[%d;1H  %-5s %s341K%s\033[K' "$(( start_r + 1 ))" "TEMP" "$blue" "$reset"; t_on=0
            fi
        fi
        edge_tick
        msleep 900
    done
}

# ============================= role: radar ==================================
run_radar() {
    local name="${inst:-OPTICS}" bw bh box_r=4 box_c=3 h i j pass sx b
    local bx=() by=() reveal=(0 0 0) acquired=(0 0 0) blip_hi=1
    h=$(printf '%s' "$label$name" | cksum | cut -d' ' -f1)
    radar_static() {
        measure
        bw=$(( cols - 10 )); [ "$bw" -gt 34 ] && bw=34; [ "$bw" -lt 14 ] && bw=14
        bh=$(( lines - 8 )); [ "$bh" -gt 9 ] && bh=9; [ "$bh" -lt 4 ] && bh=4
        local top="┌" bot="└"
        for (( i = 0; i < bw; i++ )); do top+="─"; bot+="─"; done
        top+="┐"; bot+="┘"
        inst="$name" peri_header "NAV"
        printf '\033[%d;%dH%s%s%s' "$box_r" "$box_c" "$dim" "$top" "$reset"
        for (( i = 1; i <= bh; i++ )); do
            printf '\033[%d;%dH%s│%s\033[%d;%dH%s│%s' \
                "$(( box_r + i ))" "$box_c" "$dim" "$reset" \
                "$(( box_r + i ))" "$(( box_c + bw + 1 ))" "$dim" "$reset"
        done
        printf '\033[%d;%dH%s%s%s' "$(( box_r + bh + 1 ))" "$box_c" "$dim" "$bot" "$reset"
        for b in 0 1 2; do   # blip positions, stable per pane
            bx[$b]=$(( (h / (b + 3) + b * 13) % bw ))
            by[$b]=$(( (h / (b + 7) + b * 5) % bh + 1 ))
        done
    }
    radar_frame() {  # <sweep-col or -1> — interior redraw
        local sw="$1" row line c ch
        for (( row = 1; row <= bh; row++ )); do
            line=""
            for (( c = 0; c < bw; c++ )); do
                ch=" "
                [ $(( row % 2 )) -eq 0 ] && [ $(( c % 3 )) -eq 1 ] && ch="${dim}·${reset}"
                [ "$c" -eq "$sw" ] && ch="${dim}│${reset}"
                for b in 0 1 2; do
                    if [ "${bx[$b]}" -eq "$c" ] && [ "${by[$b]}" -eq "$row" ]; then
                        if [ "${acquired[$b]}" -eq 1 ]; then
                            if [ "$blip_hi" -eq 1 ]; then ch="${bold}${blue}◆${reset}"
                            else ch="${dim}${blue}◆${reset}"; fi
                        elif [ "${reveal[$b]}" -eq 1 ]; then ch="${red}◆${reset}"; fi
                    fi
                done
                line+="$ch"
            done
            printf '\033[%d;%dH%s' "$(( box_r + row ))" "$(( box_c + 1 ))" "$line"
        done
    }
    radar_static                 # lit from frame one [SB-frames]
    radar_frame -1
    [ "$delay_ms" -gt 0 ] && msleep "$delay_ms"

    for pass in 0 1; do          # pass 1 reveals red, pass 2 acquires blue
        for (( sx = 0; sx < bw; sx++ )); do
            frame_gate
            if [ "$relayout" -eq 1 ]; then relayout=0; radar_static; fi
            for b in 0 1 2; do
                if [ "${bx[$b]}" -eq "$sx" ]; then
                    if [ "$pass" -eq 0 ]; then reveal[$b]=1; else acquired[$b]=1; fi
                fi
            done
            radar_frame "$sx"
            edge_tick
            msleep "$(sc 40)"
        done
    done
    radar_frame -1
    flash2 "$(( box_r + bh + 2 ))" 3 "NAV LOCK"
    printf '\033[%d;3H%s%sNAV LOCK%s\033[K%s' "$(( box_r + bh + 2 ))" "$bold" "$blue" "$reset" "$show"
    # ambient idle: acquired blips breathe bold-blue ↔ dim-blue [FUI-lit]
    while :; do
        frame_gate
        if [ "$relayout" -eq 1 ]; then
            relayout=0; radar_static
            printf '\033[%d;3H%s%sNAV LOCK%s\033[K' "$(( box_r + bh + 2 ))" "$bold" "$blue" "$reset"
        fi
        blip_hi=$(( 1 - blip_hi ))
        radar_frame -1
        edge_tick
        msleep 800
    done
}

case "$role" in
    main)  run_main ;;
    gauge) run_gauge ;;
    scope) run_scope ;;
    strip) run_strip ;;
    radar) run_radar ;;
    *) echo "saturday-cockpit-boot-stub: unknown role: $role" >&2; exit 2 ;;
esac
