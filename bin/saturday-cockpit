#!/usr/bin/env bash
# saturday-cockpit — Posture A topology: one tmux window holding every Claude
# Code session as a pane, so saturday-stage can maximize (zoom) the addressed
# session or tile the panes by salience — all native tmux, no Wayland.
#
# This is the alternative to per-project `saturday-claude` sessions (one tmux
# session per dir, each in its own terminal). The cockpit trades cross-monitor
# spread for native within-window choreography: zoom-to-focus and
# salience-proportional tiling that stage drives on the inject lifecycle.
#
# Usage:
#   saturday-cockpit ~/Documents/lucida ~/Documents/saturday ~/src/groupchat
#   saturday-cockpit [--resume] [--dangerously-skip-permissions] [--remote-control] <dir> [<dir> ...]
#                                   # all flags apply to CLAUDE_CMD for every
#                                   # pane in this initial batch (see below —
#                                   # same flags, same meaning, as on `add`).
#                                   # --pellicle is add-only; see below.
#   saturday-cockpit --boot <dir> [<dir> ...]
#                                   # opt-in staggered reveal: every pane
#                                   # shows a themed placeholder first, then
#                                   # real commands pop in one at a time —
#                                   # the addressed pane (first dir) settles
#                                   # last. Composes with --resume/
#                                   # --resume-last/--dangerously-skip-
#                                   # permissions/--remote-control; not
#                                   # available with --pellicle (initial-
#                                   # launch-only restriction, see below).
#   saturday-cockpit add <dir> [<dir> ...]   # add pane(s) to a running cockpit
#   saturday-cockpit add --pellicle <dir> [<dir> ...]
#                                   # add pane(s) as a pellicle status+claude
#                                   # pair instead of a bare claude pane —
#                                   # needs ~/Documents/pellicle (PELLICLE_DIR).
#                                   # add-only: the first/initial pane is built
#                                   # via new-session, not split-window, so it
#                                   # has no pellicle path of its own yet.
#   saturday-cockpit add --resume <dir> [<dir> ...]
#                                   # run `claude --resume` instead of a
#                                   # fresh session — drops into Claude's own
#                                   # interactive picker per pane, scoped to
#                                   # that dir's own past sessions. Composes
#                                   # with --pellicle. For a known session id
#                                   # instead of the picker, still use
#                                   # CLAUDE_CMD='claude --resume <id>' add.
#   saturday-cockpit add --resume-last <dir> [<dir> ...]
#                                   # non-interactive: resolve each dir's
#                                   # most-recently-modified session file
#                                   # under ~/.claude/projects/<encoded-dir>/
#                                   # and pass it straight through as
#                                   # `claude --resume <id>` — no picker.
#                                   # A dir with no prior session starts
#                                   # fresh instead of failing the batch.
#                                   # Mutually exclusive with --resume.
#   saturday-cockpit add --dangerously-skip-permissions <dir> [<dir> ...]
#                                   # pass the flag straight through to claude
#                                   # for that pane. Composes with --pellicle
#                                   # and --resume.
#   saturday-cockpit add --remote-control <dir> [<dir> ...]
#                                   # (alias --rc) pass claude's own
#                                   # --remote-control straight through, so
#                                   # that pane's session is bridged and
#                                   # reachable from another device (phone,
#                                   # claude.ai) as soon as it starts.
#                                   # Composes with --resume/--resume-last —
#                                   # useful together: resume a session here
#                                   # and immediately make it phone-reachable.
#   saturday-cockpit add --title "Name" <dir>
#                                   # label the pane border with "Name"
#                                   # instead of the dir basename — for when
#                                   # the dir name alone doesn't say what the
#                                   # session is. Single-dir only (one title
#                                   # can't label a whole batch); add panes
#                                   # one at a time to title each.
#   saturday-cockpit stop          # kill the cockpit window/session
#   saturday-cockpit status        # list panes (pane_id, pid, cwd)
#
# Hotkeys (no prefix, work anywhere in tmux once a cockpit has run once):
#   Alt+1..9   jump to pane N, zoomed full-screen; press the same number
#              again to toggle back to the tiled overview
#   Alt+0      force the tiled overview regardless of zoom state
#
# Env:
#   CLAUDE_CMD   command run in each pane (default: claude). Each pane cd's into
#                its dir and execs this — plain `claude` so the watcher/mayor
#                discover it by walking /proc per cwd (no nested tmux wrapper).
#   COCKPIT      tmux session name (default: cc-cockpit — matches stage's ^cc-
#                activity allowlist). Set a different name to run a second
#                cockpit on another monitor.
#   COCKPIT_TILE even-horizontal | even-vertical | tiled (default tiled — a
#                grid scales far better than a single row/column once more
#                than 3-4 panes are open; even-horizontal was the default
#                until 2026-08-25, when 9 panes made it unusable (~1/9
#                terminal width each). A genuinely dynamic/weighted layout
#                remains a separate, deferred piece of work — this is a
#                better static default in the meantime, not that rewrite.
#   COCKPIT_BOOT_STUB  command run in each pane during --boot's placeholder
#                phase (default: saturday-cockpit-boot-stub). Only read when
#                --boot is passed.
#
# Pair with stage zoom/tile on mayor:
#   saturday-mayor ... --stage-sock /tmp/saturday-stage.sock --stage-zoom
#   (or --stage-tile for graded salience widths instead of full zoom)

set -euo pipefail

SESSION="${COCKPIT:-cc-cockpit}"
CLAUDE_CMD="${CLAUDE_CMD:-claude}"
LAYOUT="${COCKPIT_TILE:-tiled}"

# Alt+letter pane-jump keys for panes 10+ (Alt+1..9 covers panes 1-9, Alt+0
# is the overview reset — see bind_hotkeys). Ordered by physical proximity
# to the left Alt key itself, skipping b/c/d/f/l/r/t/u/y: those are
# readline's default Meta-letter word-navigation bindings (forward/
# backward-word, kill-word, ...) in every bash/zsh pane, and these are
# root-table, global-to-server binds, not just Saturday's. One array feeds
# both bind_hotkeys (the actual keybinding) and the pane-border label below
# it, so the two can't drift apart.
COCKPIT_HOTKEY_LETTERS=(z s x a w q v e)

# wait_pane_settled polls a pane's rendered content until it stops changing
# for two consecutive polls, or max_wait seconds elapse. Used between pane
# launches: starting two `claude` processes within the same fraction of a
# second races Claude Code's own startup project-identity bookkeeping — a
# pane launched simultaneously with another has been observed to inherit
# the OTHER pane's project name in its own status line (reproduced live,
# 2026-08-24: a pellicle-free mcp-dispatch pane launched alongside a
# basanite one showed "basanite" in its own status line and dispatch
# identity until relaunched alone). Waiting for the previous pane's
# startup rendering to finish before starting the next avoids the race
# without guessing a fixed sleep duration. Never hard-fails the caller —
# a timeout just means "settle-detection gave up," not "this pane is
# broken," so add_pane's loop logs a warning and moves on regardless.
wait_pane_settled() {
    local pane="$1" max_wait="${2:-10}" poll=0.3
    local iters=$(( (max_wait * 10) / 3 ))
    local prev="" cur="" stable=0 i=0
    while [ "$i" -lt "$iters" ]; do
        cur="$(tmux capture-pane -t "$pane" -p 2>/dev/null || true)"
        if [ -n "$cur" ] && [ "$cur" = "$prev" ]; then
            stable=$((stable + 1))
            [ "$stable" -ge 2 ] && return 0
        else
            stable=0
        fi
        prev="$cur"
        sleep "$poll"
        i=$((i + 1))
    done
    return 1
}

# next_free_slot prints the smallest positive integer not currently held by
# any live pane's @cockpit_slot user option in $SESSION. Slots are assigned
# once, at pane creation, and never reassigned (see bind_hotkeys/
# pane_hotkey_label below) — a killed pane's slot just stops showing up in
# this scan (tmux drops pane user options with the pane), so reuse happens
# automatically without a free-list to maintain, and only ever for a slot
# whose session is actually gone.
next_free_slot() {
    local used n=1
    used="$(tmux list-panes -t "$SESSION" -F '#{@cockpit_slot}' 2>/dev/null | grep -E '^[0-9]+$' | sort -n)"
    for u in $used; do
        if [ "$u" -eq "$n" ]; then
            n=$((n + 1))
        elif [ "$u" -gt "$n" ]; then
            break
        fi
    done
    echo "$n"
}

# ensure_pane_slots backfills @cockpit_slot on any pane in $SESSION that
# doesn't have one yet — a session started before slot-based hotkeys existed
# (or by an older script version). Assigns in #{pane_id} listing order, which
# tmux hands back in pane-index order, so an already-running cockpit's
# current Alt+N muscle memory survives the upgrade unchanged. Called from
# bind_hotkeys, which already runs before any new pane gets created in both
# the initial-launch and `add` paths, so backfilled slots are claimed before
# next_free_slot is asked for a fresh one.
ensure_pane_slots() {
    local pane_id existing
    while IFS= read -r pane_id; do
        [ -z "$pane_id" ] && continue
        existing="$(tmux show-options -pqv -t "$pane_id" @cockpit_slot 2>/dev/null || true)"
        [ -n "$existing" ] && continue
        tmux set-option -p -t "$pane_id" @cockpit_slot "$(next_free_slot)"
    done < <(tmux list-panes -t "$SESSION" -F '#{pane_id}' 2>/dev/null)
}

# Split a new pane for $1 into the running session and re-balance. Shared by
# the initial build loop and `add`, so a running cockpit and a fresh one grow
# panes the same way. Callers that launch more than one pane in a batch are
# responsible for wait_pane_settled-ing between calls (see wait_pane_settled
# above for why) — add_pane itself stays a single, fast, unconditional split
# so callers that only ever add one pane at a time pay no extra latency.
add_pane() {
    local dir="$1" cmd="${2:-$CLAUDE_CMD}" title="${3:-}"
    local pane_id
    pane_id="$(tmux split-window -t "$SESSION" -P -F '#{pane_id}' "cd '$dir' && exec $cmd")"
    [ -n "$title" ] && tmux set-option -p -t "$pane_id" @cockpit_title "$title"
    tmux set-option -p -t "$pane_id" @cockpit_slot "$(next_free_slot)"
    tmux select-layout -t "$SESSION" "$LAYOUT" >/dev/null
}

# resolve_last_session prints the session id (jsonl basename) of the
# most-recently-modified transcript for $1's project dir, or nothing (exit 1)
# if the dir has no ~/.claude/projects/ entry or no session files yet.
# Encoding matches watcher/main.go's encodedHomePrefix exactly: absolute
# path, leading slash stripped, every remaining '/' turned into '-', whole
# thing prefixed with '-' (verified against this host's own live
# ~/.claude/projects/-home-gas6amus-Documents-saturday).
resolve_last_session() {
    local dir="$1" abs encoded projdir latest
    abs="$(cd "$dir" 2>/dev/null && pwd -P)" || return 1
    encoded="-${abs#/}"
    encoded="${encoded//\//-}"
    projdir="$HOME/.claude/projects/$encoded"
    [ -d "$projdir" ] || return 1
    latest="$(find "$projdir" -maxdepth 1 -name '*.jsonl' -printf '%T@ %p\n' 2>/dev/null \
        | sort -rn | head -1 | cut -d' ' -f2-)"
    [ -n "$latest" ] || return 1
    basename "$latest" .jsonl
}

# resolved_cmd_for prints the command to launch for $1, given the caller's
# already-parsed $resume_last flag and (possibly yolo-suffixed) $CLAUDE_CMD.
# A dir with no resolvable prior session warns and falls back to a fresh
# session rather than failing the whole batch — matches wait_pane_settled's
# own warn-and-continue convention above.
resolved_cmd_for() {
    local dir="$1" sid
    if [ "$resume_last" -eq 1 ]; then
        if sid="$(resolve_last_session "$dir")" && [ -n "$sid" ]; then
            echo "$CLAUDE_CMD --resume $sid"
            return
        fi
        echo "saturday-cockpit: no prior session found for $dir, starting fresh" >&2
    fi
    echo "$CLAUDE_CMD"
}

# stub_cmd_for prints the placeholder command for $1's pane during --boot's
# assembly phase — the dir's basename as the label, so each placeholder is
# distinguishable rather than all panes showing an identical generic stub.
stub_cmd_for() {
    local dir="$1"
    echo "${COCKPIT_BOOT_STUB:-saturday-cockpit-boot-stub} '$(basename "$dir")'"
}

# Same as add_pane, but the new slot is itself a nested pellicle pair — a
# claude pane with a 3-line status-render strip split above it — instead of
# a bare claude pane. Ported from ~/Documents/pellicle/pellicle-claude's own
# split logic (that script won't do this itself: it detects it's already
# inside tmux and falls back to plain claude, by design, so cockpit has to
# build the pair itself). Coordinated with the pellicle session before
# landing this.
#
# Known rough edge: add_pane's select-layout call for any OTHER dir, later,
# rebalances every pane in the window including this one's 3-line strip
# back to the general grid. pellicle's own Stop-hook resize in
# status-fallback.sh reasserts the right height on that project's next
# turn, so this self-heals rather than staying broken — but there's a
# window where it's wrong. Not fixed here; flagged instead.
add_pane_pellicle() {
    local dir="$1" cmd="${2:-$CLAUDE_CMD}" title="${3:-}"
    local pellicle_dir="${PELLICLE_DIR:-$HOME/Documents/pellicle}"
    if [ ! -x "$pellicle_dir/pellicle-pane-render.sh" ]; then
        echo "saturday-cockpit: --pellicle needs $pellicle_dir/pellicle-pane-render.sh (set PELLICLE_DIR?)" >&2
        return 1
    fi
    if ! command -v watch >/dev/null 2>&1; then
        echo "saturday-cockpit: --pellicle needs 'watch' (procps)." >&2
        return 1
    fi

    local claude_pane_id
    claude_pane_id="$(tmux split-window -t "$SESSION" -P -F '#{pane_id}' "cd '$dir' && exec $cmd")"
    [ -n "$title" ] && tmux set-option -p -t "$claude_pane_id" @cockpit_title "$title"
    tmux set-option -p -t "$claude_pane_id" @cockpit_slot "$(next_free_slot)"

    local watch_cmd
    watch_cmd="watch -n 1 --no-title $(printf '%q' "$pellicle_dir/pellicle-pane-render.sh") $(printf '%q' "$dir")"

    local render_pane_id
    render_pane_id="$(tmux split-window -v -b -l 3 -t "$claude_pane_id" -c "$dir" -P -F '#{pane_id}' "$watch_cmd")"
    echo "$render_pane_id" > "$dir/.pellicle-pane"

    tmux select-pane -t "$claude_pane_id"
    tmux select-layout -t "$SESSION" "$LAYOUT" >/dev/null
}

# Alt+1..9: jump straight to the pane holding @cockpit_slot N, zoomed
# full-screen — press the same number again to toggle back to the tiled
# overview (tmux auto-unzooms on select-pane to a *different* pane, so
# re-selecting the one you're already on is the only case that needs the
# explicit resize-pane -Z toggle; verified live against tmux 3.6, not
# assumed from docs). Alt+0 always forces the overview. Root-table (-n, no
# prefix) and global to the tmux server, so these also work as a plain
# pane-jump facility outside the cockpit — they don't collide with anything:
# stock tmux only binds M-1..M-9 in the prefix and copy-mode tables, never
# in root.
#
# Targets a pane by @cockpit_slot, not #{pane_index} — tmux renumbers
# pane_index every time a pane is added or killed, which used to mean Alt+9
# could silently point at a different session than the one you last saw
# there. @cockpit_slot is assigned once at pane creation (add_pane/
# add_pane_pellicle) and never reassigned, so the lookup below is resolved
# fresh at *keypress* time via a run-shell filter — `p=$(...)` and `"$p"`
# are left unescaped-by-bash (backslash-escaped $ below) so they're
# evaluated by tmux's run-shell subshell when the key is pressed, not by
# this script at bind time.
bind_hotkeys() {
    tmux set-option -g pane-base-index 1
    ensure_pane_slots
    for n in 1 2 3 4 5 6 7 8 9; do
        tmux bind-key -n "M-$n" run-shell "p=\$(tmux list-panes -t $SESSION -f '#{==:#{@cockpit_slot},$n}' -F '#{pane_id}' | head -1); [ -n \"\$p\" ] && tmux select-pane -t \"\$p\"; tmux resize-pane -Z"
    done
    # Alt+letter: same scheme, panes 10+, once a session outgrows the nine
    # digits (M-0 is the overview reset above, not a tenth pane). See
    # COCKPIT_HOTKEY_LETTERS above for why these letters and not others.
    local pane=10
    for l in "${COCKPIT_HOTKEY_LETTERS[@]}"; do
        tmux bind-key -n "M-$l" run-shell "p=\$(tmux list-panes -t $SESSION -f '#{==:#{@cockpit_slot},$pane}' -F '#{pane_id}' | head -1); [ -n \"\$p\" ] && tmux select-pane -t \"\$p\"; tmux resize-pane -Z"
        pane=$((pane + 1))
    done
    # Un-zoom if zoomed, then always re-tile to even shares — stage's
    # proportionalTile leaves panes at an emphasis skew (resize-pane -x) that
    # zoom-checking alone doesn't touch, so without this second command M-0
    # only fixed the zoom case and left a tile-skewed layout untouched.
    tmux bind-key -n M-0 run-shell "tmux if-shell -F '#{window_zoomed_flag}' 'resize-pane -Z' ; tmux select-layout -t $SESSION $LAYOUT"

    # kill-pane (e.g. clearing a dead remain-on-exit pane) doesn't re-tile on
    # its own — tmux just hands the freed space to a neighbor, leaving an
    # uneven layout. add_pane/add_pane_pellicle already re-balance after every
    # split; this is the same fix for the removal side. Verified live: without
    # it, killing 1 of 3 even-horizontal panes left 33/33/66; with it, 50/50.
    tmux set-hook -t "$SESSION" after-kill-pane "select-layout -t $SESSION $LAYOUT"
}

# pane_hotkey_label builds the tmux format expression for the pane-border
# label: #{@cockpit_slot} is already the right label for panes 1-9 (that
# number IS the Alt+N key — see bind_hotkeys for why this is the sticky
# slot, not #{pane_index}), but for pane 10+ the border must show the
# actual Alt+letter from COCKPIT_HOTKEY_LETTERS instead of the raw slot
# number, or the label lies about which key selects that pane. A chain of
# #{?#{==:...}} ternaries, built from the same array bind_hotkeys uses, so
# label and binding can't drift apart. NOT #{if:...} — that reads as a
# literal, unrecognized format function on tmux 3.6 (verified live: it
# just dumps "if:1,YES,NO" instead of evaluating) — #{?cond,true,false} is
# the real ternary, confirmed live nested 8 deep. A pane with no slot yet
# (the pellicle render strip, which never gets one — see add_pane_pellicle)
# falls through to an empty #{@cockpit_slot}, which is correct: it isn't a
# hotkey target.
pane_hotkey_label() {
    local expr='#{@cockpit_slot}'
    local pane=10
    for l in "${COCKPIT_HOTKEY_LETTERS[@]}"; do
        expr="#{?#{==:#{@cockpit_slot},$pane},$l,$expr}"
        pane=$((pane + 1))
    done
    echo "$expr"
}

# apply_border_format (re)asserts the pane-border rendering options. Called
# at initial launch and again from `add`, so a cockpit already running under
# an older script version picks up border-format changes (e.g. --title
# support below) live, without a full restart. The label falls back to the
# dir basename unless the pane carries a @cockpit_title user option, set by
# `add --title` — a plain #{pane_title} isn't used for this because Claude
# Code's own terminal-title escape sequences would fight it.
apply_border_format() {
    tmux set-option -t "$SESSION" remain-on-exit on
    tmux set-window-option -t "$SESSION" pane-border-status top
    tmux set-window-option -t "$SESSION" pane-border-format \
        " $(pane_hotkey_label):#{?@cockpit_title,#{@cockpit_title},#{b:pane_current_path}} "
}

case "${1:-}" in
    stop|down|kill)
        if tmux has-session -t "$SESSION" 2>/dev/null; then
            tmux kill-session -t "$SESSION"
            echo "saturday-cockpit: session killed."
        else
            echo "saturday-cockpit: no session running."
        fi
        exit 0
        ;;
    status)
        if tmux has-session -t "$SESSION" 2>/dev/null; then
            tmux list-panes -t "$SESSION" -F '#{pane_id} #{pane_pid} #{pane_current_path}'
        else
            echo "saturday-cockpit: not running."
            exit 1
        fi
        exit 0
        ;;
    add)
        shift
        if ! tmux has-session -t "$SESSION" 2>/dev/null; then
            echo "saturday-cockpit: no session running. Start one with: saturday-cockpit <dir> [<dir> ...]" >&2
            exit 1
        fi
        bind_hotkeys
        apply_border_format
        pellicle=0
        resume=0
        resume_last=0
        yolo=0
        rc=0
        title=""
        while [ "$#" -gt 0 ]; do
            case "$1" in
                --pellicle) pellicle=1; shift ;;
                --resume) resume=1; shift ;;
                --resume-last) resume_last=1; shift ;;
                --dangerously-skip-permissions) yolo=1; shift ;;
                --remote-control|--rc) rc=1; shift ;;
                --title)
                    if [ "$#" -lt 2 ]; then
                        echo "saturday-cockpit: --title needs a value" >&2
                        exit 2
                    fi
                    title="$2"; shift 2 ;;
                --) shift; break ;;
                --*)
                    echo "saturday-cockpit: unknown flag: $1" >&2
                    exit 2
                    ;;
                *) break ;;
            esac
        done
        if [ "$resume" -eq 1 ] && [ "$resume_last" -eq 1 ]; then
            echo "saturday-cockpit: --resume and --resume-last are mutually exclusive" >&2
            exit 2
        fi
        if [ "$resume" -eq 1 ]; then
            CLAUDE_CMD="$CLAUDE_CMD --resume"
        fi
        if [ "$yolo" -eq 1 ]; then
            CLAUDE_CMD="$CLAUDE_CMD --dangerously-skip-permissions"
        fi
        if [ "$rc" -eq 1 ]; then
            CLAUDE_CMD="$CLAUDE_CMD --remote-control"
        fi
        if [ "$#" -lt 1 ]; then
            echo "usage: saturday-cockpit add [--pellicle] [--resume | --resume-last] [--dangerously-skip-permissions] [--remote-control|--rc] [--title <name>] <dir> [<dir> ...]" >&2
            exit 2
        fi
        if [ -n "$title" ] && [ "$#" -gt 1 ]; then
            echo "saturday-cockpit: --title only applies to a single <dir> — add panes one at a time to title each" >&2
            exit 2
        fi
        for d in "$@"; do
            if [ ! -d "$d" ]; then
                echo "saturday-cockpit: not a directory: $d" >&2
                exit 1
            fi
        done
        n="$#"; i=0
        for d in "$@"; do
            i=$((i + 1))
            dcmd="$(resolved_cmd_for "$d")"
            if [ "$pellicle" -eq 1 ]; then
                add_pane_pellicle "$d" "$dcmd" "$title"
            else
                add_pane "$d" "$dcmd" "$title"
            fi
            # Only wait between launches, not after the last one — see
            # wait_pane_settled's comment for why this matters.
            if [ "$i" -lt "$n" ]; then
                newpane="$(tmux list-panes -t "$SESSION" -F '#{pane_id}' | tail -1)"
                wait_pane_settled "$newpane" 10 ||
                    echo "saturday-cockpit: warning: $d's pane didn't settle within 10s, continuing anyway" >&2
            fi
        done
        total="$(tmux list-panes -t "$SESSION" | wc -l)"
        echo "saturday-cockpit: added $# pane(s), $total total."
        exit 0
        ;;
esac

if [ -n "${TMUX:-}" ]; then
    echo "saturday-cockpit: already inside tmux. Open a fresh terminal." >&2
    exit 1
fi
if ! command -v tmux >/dev/null 2>&1; then
    echo "saturday-cockpit: tmux not installed (apt install tmux)." >&2
    exit 1
fi

# Reattach an existing cockpit rather than rebuild it.
if tmux has-session -t "$SESSION" 2>/dev/null; then
    exec tmux attach-session -t "$SESSION"
fi

# --resume/--dangerously-skip-permissions apply to CLAUDE_CMD for the whole
# initial batch, same as they do in `add`. --pellicle isn't accepted here:
# the first pane is built via `new-session`, not `split-window`, so it needs
# its own pane-creation path that doesn't exist yet — launch plain, then
# `add --pellicle` once the session is up.
resume=0
resume_last=0
yolo=0
rc=0
boot=0
while [ "$#" -gt 0 ]; do
    case "$1" in
        --resume) resume=1; shift ;;
        --resume-last) resume_last=1; shift ;;
        --dangerously-skip-permissions) yolo=1; shift ;;
        --remote-control|--rc) rc=1; shift ;;
        --boot) boot=1; shift ;;
        --pellicle)
            echo "saturday-cockpit: --pellicle only works with 'add' — launch plain, then: saturday-cockpit add --pellicle <dir>" >&2
            exit 2
            ;;
        --) shift; break ;;
        --*)
            echo "saturday-cockpit: unknown flag: $1" >&2
            exit 2
            ;;
        *) break ;;
    esac
done
if [ "$resume" -eq 1 ] && [ "$resume_last" -eq 1 ]; then
    echo "saturday-cockpit: --resume and --resume-last are mutually exclusive" >&2
    exit 2
fi
if [ "$resume" -eq 1 ]; then
    CLAUDE_CMD="$CLAUDE_CMD --resume"
fi
if [ "$yolo" -eq 1 ]; then
    CLAUDE_CMD="$CLAUDE_CMD --dangerously-skip-permissions"
fi
if [ "$rc" -eq 1 ]; then
    CLAUDE_CMD="$CLAUDE_CMD --remote-control"
fi

if [ "$#" -lt 1 ]; then
    echo "usage: saturday-cockpit [--resume | --resume-last] [--dangerously-skip-permissions] [--remote-control|--rc] <dir> [<dir> ...]" >&2
    echo "       saturday-cockpit add [--pellicle] [--resume | --resume-last] [--dangerously-skip-permissions] [--remote-control|--rc] <dir> [<dir> ...]" >&2
    echo "       saturday-cockpit stop|status" >&2
    exit 2
fi

# Validate dirs up front so we don't build a half-cockpit.
for d in "$@"; do
    if [ ! -d "$d" ]; then
        echo "saturday-cockpit: not a directory: $d" >&2
        exit 1
    fi
done

# First pane = first dir. This is also the "addressed" pane in --boot mode —
# the only existing signal for primary in this script (structurally distinct
# via new-session, tmux's default-focused pane after it).
first="$1"; shift
firstcmd="$(resolved_cmd_for "$first")"

if [ "$boot" -eq 1 ]; then
    # remain-on-exit must be set BEFORE the first placeholder exists, not
    # after (apply_border_format sets it later, at the very end) — if the
    # stub script exits early for any reason before this lands, tmux would
    # otherwise close the pane immediately and invalidate its captured id.
    firstpane="$(tmux new-session -d -s "$SESSION" -n "cockpit" -P -F '#{pane_id}' \
        "cd '$first' && exec $(stub_cmd_for "$first")")"
    tmux set-option -t "$SESSION" remain-on-exit on
else
    tmux new-session -d -s "$SESSION" -n "cockpit" \
        "cd '$first' && exec $firstcmd"
fi
bind_hotkeys

# Remaining dirs → one split each. Re-balance after every split so tmux always
# has room for the next pane. Staggered via wait_pane_settled — see its
# comment above for why. The pane new-session just launched is a `claude`
# startup too, so if there's at least one more dir queued, wait on it before
# the first split — otherwise that split races the exact same way a second
# add_pane call would.
#
# --boot mode skips every wait_pane_settled call in this section: that race
# is specifically about two real `claude` processes racing each other's
# startup identity bookkeeping (see wait_pane_settled's comment above), and
# these placeholder panes run the boot-stub script, not claude, so the race
# can't occur — placeholders assemble back-to-back instead, matching the
# "dark cockpit assembles fast" beat of the ritual. Real commands were
# already resolved above/below via resolved_cmd_for and are only exec'd
# later, in the respawn-stagger loop, where the real settle-wait protection
# is still very much needed and still applied (with a shorter timeout).
if [ "$boot" -eq 0 ] && [ "$#" -gt 0 ]; then
    firstpane="$(tmux list-panes -t "$SESSION" -F '#{pane_id}' | tail -1)"
    wait_pane_settled "$firstpane" 10 ||
        echo "saturday-cockpit: warning: $first's pane didn't settle within 10s, continuing anyway" >&2
fi
n="$#"; i=0
boot_dirs=(); boot_cmds=(); boot_pane_ids=()
for d in "$@"; do
    i=$((i + 1))
    if [ "$boot" -eq 1 ]; then
        add_pane "$d" "$(stub_cmd_for "$d")"
        newpane="$(tmux list-panes -t "$SESSION" -F '#{pane_id}' | tail -1)"
        boot_dirs+=("$d")
        boot_cmds+=("$(resolved_cmd_for "$d")")
        boot_pane_ids+=("$newpane")
    else
        add_pane "$d" "$(resolved_cmd_for "$d")"
        if [ "$i" -lt "$n" ]; then
            newpane="$(tmux list-panes -t "$SESSION" -F '#{pane_id}' | tail -1)"
            wait_pane_settled "$newpane" 10 ||
                echo "saturday-cockpit: warning: $d's pane didn't settle within 10s, continuing anyway" >&2
        fi
    fi
done

# Keep dead panes readable; show per-pane titles (basenames, or a custom
# --title) along the top border so the cockpit is legible and stage's title
# marker has a home.
apply_border_format
tmux select-layout -t "$SESSION" "$LAYOUT" >/dev/null

# --boot's reveal: layout is already settled above, so nothing resizes during
# this loop — respawn-pane swaps a pane's running command in place. Order:
# non-addressed panes first (argv order), the addressed pane (first dir)
# last, each gated on wait_pane_settled so a real `claude` respawn still gets
# the same startup-identity protection add_pane's callers get — just with a
# shorter timeout than the default 10s, since N non-addressed panes each
# capable of timing out before the addressed pane's respawn even starts
# would otherwise risk 30-50s before the "primary settles last" payoff.
if [ "$boot" -eq 1 ]; then
    for idx in "${!boot_dirs[@]}"; do
        d="${boot_dirs[$idx]}"; cmd="${boot_cmds[$idx]}"; pane="${boot_pane_ids[$idx]}"
        tmux respawn-pane -k -t "$pane" "cd '$d' && exec $cmd"
        wait_pane_settled "$pane" 5 ||
            echo "saturday-cockpit: warning: $d's pane didn't settle within 5s, continuing anyway" >&2
    done
    tmux respawn-pane -k -t "$firstpane" "cd '$first' && exec $firstcmd"
    wait_pane_settled "$firstpane" 5 ||
        echo "saturday-cockpit: warning: $first's pane didn't settle within 5s, continuing anyway" >&2
fi

echo "saturday-cockpit: '$SESSION' up with $(($# + 1)) panes ($LAYOUT)."
echo "  Alt+1..9 jump-and-zoom to a pane (press again to un-zoom), Alt+0 forces the overview."
echo "  stage drives zoom/tile on inject when mayor runs with --stage-zoom / --stage-tile."

if [ -t 1 ]; then
    exec tmux attach-session -t "$SESSION"
else
    echo "  (no TTY — attach with: tmux attach -t $SESSION)"
fi
