#!/usr/bin/env bash
# saturday-cockpit — Posture A topology: one tmux window holding every Claude
# Code session as a pane, so saturday-stage can maximize (zoom) the addressed
# session or tile the panes by salience — all native tmux, no Wayland.
#
# This is the alternative to per-project `saturday-claude` sessions (one tmux
# session per dir, each in its own terminal). The cockpit trades cross-monitor
# spread for native within-window choreography: zoom-to-focus and
# salience-proportional tiling that stage drives on the inject lifecycle.
#
# Usage:
#   saturday-cockpit ~/Documents/lucida ~/Documents/saturday ~/src/groupchat
#   saturday-cockpit [--resume [--allow-fresh]] [--dangerously-skip-permissions] [--remote-control] <dir|name> ...
#                                   # --resume is non-interactive by default
#                                   # (see add --resume below); --resume-picker
#                                   # opts into claude's own interactive picker.
#                                   # all flags apply to CLAUDE_CMD for every
#                                   # pane in this initial batch (see below —
#                                   # same flags, same meaning, as on `add`).
#                                   # --pellicle is add-only; see below.
#                                   # A <name> is any NAME `status` has shown
#                                   # for a pane (its --title, its /rename'd
#                                   # Claude session name, or its dir
#                                   # basename), looked up in the pane
#                                   # manifest (see Manifest below).
#   saturday-cockpit --resume       # no dirs: restore the last cockpit from
#                                   # its manifest, slot order, each pane on
#                                   # its own last session with its own flags
#                                   # and title, watch panes included.
#   saturday-cockpit --boot [fast] <dir> [<dir> ...]
#                                   # opt-in Steel Battalion boot ritual:
#                                   # the addressed pane (first dir) holds a
#                                   # dark center display while peripheral
#                                   # panes slide in from the window edges
#                                   # as DISTINCT instruments (gauge/scope/
#                                   # radar/strip; red testing → blue
#                                   # confirmed), the center runs its
#                                   # checklist → VT-OS log → live-feed arc,
#                                   # then real commands respawn in one at a
#                                   # time — addressed pane last — and the
#                                   # ritual's hero-ring layout hands back
#                                   # to COCKPIT_TILE. `--boot fast` picks
#                                   # ~1s snap pacing over the ~3s fills.
#                                   # Composes with --resume/--resume-picker/
#                                   # --dangerously-skip-permissions/
#                                   # --remote-control; not available with
#                                   # --pellicle (initial-launch-only
#                                   # restriction, see below).
#   saturday-cockpit add <dir> [<dir> ...]   # add pane(s) to a running cockpit
#   saturday-cockpit add --pellicle <dir> [<dir> ...]
#                                   # add pane(s) as a pellicle status+claude
#                                   # pair instead of a bare claude pane —
#                                   # needs ~/Documents/pellicle (PELLICLE_DIR).
#                                   # add-only: the first/initial pane is built
#                                   # via new-session, not split-window, so it
#                                   # has no pellicle path of its own yet.
#   saturday-cockpit add --resume <dir> [<dir> ...]
#                                   # non-interactive: resume the pane's own
#                                   # last session (from the manifest) if its
#                                   # transcript still exists, else the newest
#                                   # transcript started in that dir, as
#                                   # `claude --resume <id>` — no picker, so
#                                   # no pane sits stuck waiting on a human
#                                   # in an otherwise-scriptable cockpit.
#                                   # Every dir is resolved before any pane is
#                                   # built; a dir with no session to resume
#                                   # stops the batch unless --allow-fresh,
#                                   # which starts those dirs fresh instead.
#                                   # A dir with a manifest row keeps its
#                                   # remembered flags (--model, --rc, ...)
#                                   # unless this call passes claude flags or
#                                   # sets CLAUDE_CMD. The summary names the
#                                   # session each pane got.
#                                   # --resume-last is a recognized synonym.
#                                   # Mutually exclusive with --resume-picker.
#   saturday-cockpit add --resume-picker <dir> [<dir> ...]
#                                   # run `claude --resume` instead of a
#                                   # fresh session — drops into Claude's own
#                                   # interactive picker per pane, scoped to
#                                   # that dir's own past sessions. Composes
#                                   # with --pellicle. For a known session id
#                                   # instead of either, still use
#                                   # CLAUDE_CMD='claude --resume <id>' add.
#   saturday-cockpit add --dangerously-skip-permissions <dir> [<dir> ...]
#                                   # pass the flag straight through to claude
#                                   # for that pane. Composes with --pellicle
#                                   # and --resume/--resume-picker.
#   saturday-cockpit add --remote-control <dir> [<dir> ...]
#                                   # (alias --rc) pass claude's own
#                                   # --remote-control straight through, so
#                                   # that pane's session is bridged and
#                                   # reachable from another device (phone,
#                                   # claude.ai) as soon as it starts.
#                                   # Composes with --resume/--resume-picker —
#                                   # useful together: resume a session here
#                                   # and immediately make it phone-reachable.
#   saturday-cockpit add --title "Name" <dir>
#                                   # label the pane border with "Name"
#                                   # instead of the dir basename — for when
#                                   # the dir name alone doesn't say what the
#                                   # session is. Single-dir only (one title
#                                   # can't label a whole batch); add panes
#                                   # one at a time to title each.
#   saturday-cockpit restart [<slot>|<name>|<%pane>]
#                                   # respawn a pane's claude in place,
#                                   # resuming the exact session it holds
#                                   # (from ~/.claude/sessions/<pid>.json)
#                                   # with the flags it was launched with —
#                                   # e.g. to pick up a newly installed MCP
#                                   # server without losing the conversation.
#                                   # No argument inside the cockpit: restart
#                                   # this pane, after COCKPIT_RESTART_DELAY
#                                   # so the current turn can finish.
#                                   # Background tasks don't survive it.
#   saturday-cockpit wake [<slot>|<name>|<%pane>]
#                                   # SIGCONT a pane suspended with ctrl+z.
#                                   # claude says "run fg", but a cockpit
#                                   # pane has no shell to run it in (claude
#                                   # is exec'd). Alt+N does this too.
#   saturday-cockpit watch [--name N] [--window] [--dir D] -- <cmd> ...
#                                   # a non-claude pane (log tail, live viz)
#                                   # split in detached: focus never moves.
#                                   # Gets a slot and a manifest row.
#   saturday-cockpit stop          # kill the cockpit window/session
#   saturday-cockpit status        # SLOT NAME STATE DIR SESSION PANE, by
#                                   # slot (the Alt+N number, not tmux's
#                                   # pane index). STATE: busy/idle/... from
#                                   # Claude's session record, suspended,
#                                   # dead, or watch.
#   restart, wake and watch are tmux-only (ttmux has no respawn, pane pid
#   or detached split). bin/saturday-cockpit-term opens the cockpit in a
#   terminal window of its own, for callers without one.
#
# Hotkeys (no prefix, work anywhere in tmux once a cockpit has run once):
#   Alt+1..9   jump to pane N, zoomed full-screen; press the same number
#              again to toggle back to the tiled overview. Also wakes the
#              pane if it's suspended.
#   Alt+0      force the tiled overview regardless of zoom state
#
# Manifest: ~/.local/state/saturday-cockpit/<session>.tsv, one row per
# slotted pane (dir, kind, title, chosen session name, launch command, last
# session id), rewritten from the live panes on launch, add, watch,
# restart, status and stop. It's what names, remembered flags, restart and
# bare --resume read. A cockpit started before it existed adopts itself on
# the first `status`.
#
# Env:
#   CLAUDE_CMD   command run in each pane (default: claude). Each pane cd's into
#                its dir and execs this — plain `claude` so the watcher/mayor
#                discover it by walking /proc per cwd (no nested tmux wrapper).
#   COCKPIT      tmux session name (default: cc-cockpit — matches stage's ^cc-
#                activity allowlist). Set a different name to run a second
#                cockpit on another monitor.
#   COCKPIT_TILE even-horizontal | even-vertical | tiled (default tiled — a
#                grid scales far better than a single row/column once more
#                than 3-4 panes are open; even-horizontal was the default
#                until 2026-08-25, when 9 panes made it unusable (~1/9
#                terminal width each). A genuinely dynamic/weighted layout
#                remains a separate, deferred piece of work — this is a
#                better static default in the meantime, not that rewrite.
#   COCKPIT_BOOT_STUB  instrument-pane script for --boot's assembly phase
#                (default: saturday-cockpit-boot-stub). Invoked per pane as
#                <stub> <label> --role <main|gauge|scope|radar|strip>
#                [--inst <SUBSYSTEM>] --delay <ms> [--fast]. Only read when
#                --boot is passed.
#   COCKPIT_BACKEND  tmux (default) | ttmux — which multiplexer this cockpit
#                drives. ttmux (https://github.com/statico/ttmux) is opt-in,
#                personal-dogfood territory while it's still beta: no
#                --boot support under it (refuses cleanly), and its own
#                cockpit-backend-ttmux.sh header documents the mechanisms
#                that don't map 1:1 from tmux (and ROADMAP.md rank 17 what
#                ttmux would need to close them).
#   COCKPIT_RESTART_DELAY  seconds a self-restart waits before respawning
#                (default 5), so the turn that asked for it can end.
#   COCKPIT_WATCH_MAX_PANES  cockpit-window pane count at which `watch`
#                opens a detached window of its own instead (default 9).
#
# Pair with stage zoom/tile on mayor:
#   saturday-mayor ... --stage-sock /tmp/saturday-stage.sock --stage-zoom
#   (or --stage-tile for graded salience widths instead of full zoom)

set -euo pipefail

SESSION="${COCKPIT:-cc-cockpit}"
# an explicit CLAUDE_CMD always wins over a pane's remembered command
CLAUDE_CMD_EXPLICIT=0
[ -n "${CLAUDE_CMD:-}" ] && CLAUDE_CMD_EXPLICIT=1
CLAUDE_CMD="${CLAUDE_CMD:-claude}"
LAYOUT="${COCKPIT_TILE:-tiled}"
LAST_PANE=""    # set by add_pane / add_pane_pellicle
PLAN_SLOTS=()   # per-argument manifest slot for plan_launches (bare --resume)
COCKPIT_BACKEND="${COCKPIT_BACKEND:-tmux}"

case "$COCKPIT_BACKEND" in
    tmux|ttmux) ;;
    *)
        echo "saturday-cockpit: unknown COCKPIT_BACKEND: $COCKPIT_BACKEND (want tmux or ttmux)" >&2
        exit 2
        ;;
esac
# shellcheck source=cockpit-backend-tmux.sh
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)/cockpit-backend-${COCKPIT_BACKEND}.sh"
# shellcheck source=cockpit-lib.sh
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)/cockpit-lib.sh"
backend_require

# Alt+letter pane-jump keys for panes 10+ (Alt+1..9 covers panes 1-9, Alt+0
# is the overview reset — see bind_hotkeys). Ordered by physical proximity
# to the left Alt key itself, skipping b/c/d/f/l/r/t/u/y: those are
# readline's default Meta-letter word-navigation bindings (forward/
# backward-word, kill-word, ...) in every bash/zsh pane, and these are
# root-table, global-to-server binds, not just Saturday's. One array feeds
# both bind_hotkeys (the actual keybinding) and the pane-border label below
# it, so the two can't drift apart.
# shellcheck disable=SC2034  # read by the sourced backend file
COCKPIT_HOTKEY_LETTERS=(z s x a w q v e)

# wait_pane_settled polls a pane's rendered content until it stops changing
# for two consecutive polls, or max_wait seconds elapse. Used between pane
# launches: starting two `claude` processes within the same fraction of a
# second races Claude Code's own startup project-identity bookkeeping — a
# pane launched simultaneously with another has been observed to inherit
# the OTHER pane's project name in its own status line (reproduced live,
# 2026-08-24: a pellicle-free mcp-dispatch pane launched alongside a
# basanite one showed "basanite" in its own status line and dispatch
# identity until relaunched alone). Waiting for the previous pane's
# startup rendering to finish before starting the next avoids the race
# without guessing a fixed sleep duration. Never hard-fails the caller —
# a timeout just means "settle-detection gave up," not "this pane is
# broken," so add_pane's loop logs a warning and moves on regardless.
wait_pane_settled() {
    local pane="$1" max_wait="${2:-10}" poll=0.3
    local iters=$(( (max_wait * 10) / 3 ))
    local prev="" cur="" stable=0 i=0
    while [ "$i" -lt "$iters" ]; do
        cur="$(backend_capture "$pane" || true)"
        if [ -n "$cur" ] && [ "$cur" = "$prev" ]; then
            stable=$((stable + 1))
            [ "$stable" -ge 2 ] && return 0
        else
            stable=0
        fi
        prev="$cur"
        sleep "$poll"
        i=$((i + 1))
    done
    return 1
}

# next_free_slot prints the smallest positive integer not currently held by
# any live pane's @cockpit_slot user option in $SESSION. Slots are assigned
# once, at pane creation, and never reassigned (see bind_hotkeys/
# pane_hotkey_label below) — a killed pane's slot just stops showing up in
# this scan (tmux drops pane user options with the pane), so reuse happens
# automatically without a free-list to maintain, and only ever for a slot
# whose session is actually gone.
next_free_slot() {
    local used n=1
    used="$(backend_used_slots)"
    for u in $used; do
        if [ "$u" -eq "$n" ]; then
            n=$((n + 1))
        elif [ "$u" -gt "$n" ]; then
            break
        fi
    done
    echo "$n"
}

# ensure_pane_slots backfills @cockpit_slot on any pane in $SESSION that
# doesn't have one yet — a session started before slot-based hotkeys existed
# (or by an older script version). Assigns in #{pane_id} listing order, which
# tmux hands back in pane-index order, so an already-running cockpit's
# current Alt+N muscle memory survives the upgrade unchanged. Called from
# bind_hotkeys, which already runs before any new pane gets created in both
# the initial-launch and `add` paths, so backfilled slots are claimed before
# next_free_slot is asked for a fresh one.
ensure_pane_slots() {
    local pane_id existing
    while IFS= read -r pane_id; do
        [ -z "$pane_id" ] && continue
        existing="$(backend_get_slot "$pane_id")"
        [ -n "$existing" ] && continue
        # a pellicle render strip belongs to the claude pane under it
        [ "$(backend_get_meta "$pane_id" kind)" = strip ] && continue
        backend_set_slot "$pane_id" "$(next_free_slot)"
    done < <(backend_list_pane_ids "$SESSION")
}

# Split a new pane for $1 into the running session and re-balance. Shared by
# the initial build loop and `add`, so a running cockpit and a fresh one grow
# panes the same way. Callers that launch more than one pane in a batch are
# responsible for wait_pane_settled-ing between calls (see wait_pane_settled
# above for why) — add_pane itself stays a single, fast, unconditional split
# so callers that only ever add one pane at a time pay no extra latency.
# Sets LAST_PANE to the new pane's id: pane-listing order isn't creation
# order once a second window (a watch pane) exists, so callers must not
# re-derive it with list-panes | tail.
add_pane() {
    local dir="$1" cmd="${2:-$CLAUDE_CMD}" title="${3:-}"
    local pane_id
    pane_id="$(backend_split "$SESSION" "$dir" "$cmd")"
    backend_set_dir "$pane_id" "$dir"
    [ -n "$title" ] && backend_set_title "$pane_id" "$title"
    backend_set_slot "$pane_id" "$(next_free_slot)"
    tag_pane "$pane_id" claude "$dir" "$cmd"
    backend_select_layout
    LAST_PANE="$pane_id"
}

# plan_launches resolves every argument before a single pane exists. An
# argument is a dir, or the name of a pane in the manifest (status's NAME
# column: title, Claude session name, or dir basename), so `--resume docs`
# finds ~/src/example.org when its session was renamed Docs. For each it settles:
#   - the absolute dir (abs_dir in cockpit-lib.sh);
#   - the command: the pane's remembered one (keeping --model,
#     --remote-control and the like across a cold restart) unless this
#     call passed claude flags or set CLAUDE_CMD ($reuse_flags);
#   - the title: its remembered --title or chosen session name;
#   - under --resume, the session: the pane's own last session if its
#     transcript still exists, else the newest one started in that dir
#     that no live pane and no earlier argument already holds (two claudes
#     on one session would write over each other's transcript).
# The remembered row is the named pane's own (by slot) when the argument is
# a name or a restore (PLAN_SLOTS[k], set by bare --resume); for a plain dir
# it's the last claude or pellicle row in that dir, never a watch pane's.
# Fills LAUNCH_DIRS, LAUNCH_CMDS, LAUNCH_TITLES and LAUNCH_NOTES,
# index-aligned with the arguments. Any unknown name, non-dir, or --resume
# with no session to find stops the whole batch with nothing built. The
# resume miss used to fall back to a fresh session with one stderr line,
# leaving a pane the user asked to resume looking healthy under the right
# label while holding an empty session. --allow-fresh ($allow_fresh) brings
# the fallback back on purpose, for a dir that has never had a session.
plan_launches() {
    LAUNCH_DIRS=(); LAUNCH_CMDS=(); LAUNCH_TITLES=(); LAUNCH_NOTES=()
    local d abs row slots slot res sid base title kind rtitle rname rcmd rsid k=-1
    local misses=() bad=0 taken=()
    # sessions live panes hold (the manifest is live while a session runs)
    if backend_has_session; then
        mapfile -t taken < <(manifest_rows | awk -F'\t' '$7 != "-" { print $7 }')
    fi
    # a restore's own sessions are spoken for before any pane falls back
    local reserved=() rs
    for rs in "${PLAN_SLOTS[@]}"; do
        rs="$(manifest_row_for_slot "$rs" | cut -f7)"
        [ -n "$rs" ] && [ "$rs" != "-" ] && reserved+=("$rs")
    done
    for d in "$@"; do
        k=$((k + 1))
        slot="${PLAN_SLOTS[$k]:-}"
        if [ -n "$slot" ]; then
            if ! abs="$(abs_dir "$d")"; then
                echo "saturday-cockpit: slot $slot's dir $d is no longer a directory" >&2
                bad=1; continue
            fi
        elif ! abs="$(abs_dir "$d")"; then
            slots="$(manifest_slots_matching "$d")"
            if [ -z "$slots" ]; then
                local known
                known="$(manifest_names)"
                echo "saturday-cockpit: not a directory or a known pane name: $d${known:+ (known: $known)}" >&2
                bad=1; continue
            fi
            if [ "$(printf '%s\n' "$slots" | wc -l)" -gt 1 ]; then
                echo "saturday-cockpit: '$d' names more than one pane — pass its dir instead" >&2
                bad=1; continue
            fi
            slot="$slots"
            abs="$(manifest_row_for_slot "$slot" | cut -f3)"
            if ! abs="$(abs_dir "$abs")"; then
                echo "saturday-cockpit: '$d' was $(manifest_row_for_slot "$slot" | cut -f3), which is no longer a directory" >&2
                bad=1; continue
            fi
        fi
        base="$CLAUDE_CMD"; title=""; rsid=""
        if [ -n "$slot" ]; then
            row="$(manifest_row_for_slot "$slot")"
        else
            row="$(manifest_row_for_dir "$abs")"
        fi
        if [ -n "$row" ]; then
            IFS=$'\t' read -r _ kind _ rtitle rname rcmd rsid <<< "$row"
            rcmd="$(undash "$rcmd")"; rsid="$(undash "$rsid")"
            if [ "$reuse_flags" -eq 1 ] && [ "$kind" != watch ] && [ -n "$rcmd" ]; then base="$rcmd"; fi
            title="$(undash "$rtitle")"
            [ -z "$title" ] && title="$(undash "$rname")"
        fi
        LAUNCH_DIRS+=("$abs")
        LAUNCH_TITLES+=("$title")
        if [ "$resume" -eq 1 ]; then
            if [ -n "$rsid" ] && transcript_exists "$abs" "$rsid" &&
                [[ " ${taken[*]} " != *" $rsid "* ]]; then
                taken+=("$rsid")
                LAUNCH_CMDS+=("$base --resume $rsid")
                LAUNCH_NOTES+=("resume $rsid (this pane's last session)")
                continue
            fi
            if res="$(resolve_last_session "$abs" "${taken[@]}" "${reserved[@]}")"; then
                sid="${res%%$'\t'*}"
                taken+=("$sid")
                LAUNCH_CMDS+=("$base --resume $sid")
                LAUNCH_NOTES+=("resume $sid (newest in dir, last written ${res#*$'\t'})")
                continue
            fi
            misses+=("$abs")
            LAUNCH_NOTES+=("fresh session (no prior session found)")
        else
            LAUNCH_NOTES+=("fresh session")
        fi
        LAUNCH_CMDS+=("$base")
    done
    [ "$bad" -eq 1 ] && exit 1
    if [ "${#misses[@]}" -gt 0 ] && [ "$allow_fresh" -eq 0 ]; then
        echo "saturday-cockpit: --resume found no prior session for:" >&2
        printf '  %s\n' "${misses[@]}" >&2
        echo "Nothing was started. Pass --allow-fresh to start those as fresh sessions instead." >&2
        exit 1
    fi
}

# print_launch_summary lists what each dir from the last plan_launches is
# running, so a wrong resume pick is catchable at a glance.
print_launch_summary() {
    local idx
    for idx in "${!LAUNCH_DIRS[@]}"; do
        printf '  %s: %s\n' "${LAUNCH_DIRS[$idx]}" "${LAUNCH_NOTES[$idx]}"
    done
}

# tag_pane <pane_id> <kind> <dir> <cmd> records on the pane itself what the
# cockpit launched into it: kind (claude, pellicle, watch, or strip for a
# pellicle render strip), dir, the command minus any --resume, and the
# session id it resumed. Stored as pane options (a sidecar under ttmux), so
# it lives and dies with the pane and no other pane can inherit it. The
# title is set separately (backend_set_title), only when there is one.
tag_pane() {
    backend_set_meta "$1" kind "$2"
    backend_set_meta "$1" dir "$3"
    backend_set_meta "$1" cmd "$(strip_resume "$4")"
    backend_set_meta "$1" sid "$(resume_id "$4")"
}

# manifest_refresh rewrites the manifest (cockpit-lib.sh) as a snapshot of
# the live slotted panes, from each pane's own tags. The session id and name
# are refreshed from the pane's Claude Code session record when it has one;
# a name with no live record is kept from that slot's previous row if it
# was the same dir. A pane with no tags (started by a cockpit from before
# tagging) is adopted once, from its start command and session record, and
# tagged, so it never needs guessing again.
manifest_refresh() {
    local pane slot pid dead start cwd title kind dir cmd sid name v prev
    while IFS=$'\t' read -r pane slot pid dead start cwd title kind dir cmd sid; do
        [ "$slot" = "-" ] && continue
        [ "$kind" = strip ] && continue
        if [ "$kind" = "-" ]; then
            kind=claude
            # older cockpits baked relative dirs into start commands, so
            # only trust an absolute one; else the session's own cwd
            dir="$(start_cmd_dir "$start")"
            if [[ "$dir" != /* ]]; then
                dir="$( [ "$pid" != "-" ] && session_field "$pid" cwd)" || dir=""
                [[ "$dir" == /* ]] || dir="$(undash "$cwd")"
            fi
            v="$(start_cmd_cmd "$start")"
            tag_pane "$pane" "$kind" "$dir" "$v"
            dir="$(dash "$dir")"
            cmd="$(dash "$(strip_resume "$v")")"
            sid="$(dash "$(resume_id "$v")")"
        fi
        name=-
        if [ "$pid" != "-" ]; then
            if v="$(session_field "$pid" sessionId)" && [ -n "$v" ]; then sid="$v"; fi
            # only names someone chose (/rename), not generated ones
            if [ "$(session_field "$pid" nameSource)" = user ] &&
                v="$(session_field "$pid" name)" && [ -n "$v" ]; then
                name="$(dash "$v")"
            fi
        fi
        if [ "$name" = "-" ] && prev="$(manifest_row_for_slot "$slot")" && [ -n "$prev" ] &&
            [ "$(cut -f3 <<< "$prev")" = "$dir" ]; then
            name="$(cut -f5 <<< "$prev")"
        fi
        printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$slot" "$kind" "$dir" "$title" "$name" "$cmd" "$sid"
    done < <(backend_pane_details) | manifest_write
}

# require_tmux_backend refuses a subcommand ttmux can't support: it has no
# respawn-pane, no pane pid and no detached split (see
# cockpit-backend-ttmux.sh's header).
require_tmux_backend() {
    if [ "$COCKPIT_BACKEND" != tmux ]; then
        echo "saturday-cockpit: $1 needs the tmux backend (COCKPIT_BACKEND=tmux) — not supported under $COCKPIT_BACKEND." >&2
        exit 2
    fi
}

# resolve_target prints the pane id an argument names: nothing means the
# pane this runs in ($TMUX_PANE); %N is a pane id; a number is a slot (the
# Alt+N number); anything else is a name, matched like status shows it —
# title, Claude session name, or dir basename, ignoring case. Fails with a
# message naming the known panes. Call after manifest_refresh.
resolve_target() {
    local arg="$1" pane="" slot="" slots
    case "$arg" in
        "")
            if [ -z "${TMUX_PANE:-}" ]; then
                echo "saturday-cockpit: name a pane (slot, name or %id) — not running inside one" >&2
                return 1
            fi
            pane="$TMUX_PANE" ;;
        %*) pane="$arg" ;;
        *[!0-9]*)
            slots="$(manifest_slots_matching "$arg")"
            if [ -z "$slots" ]; then
                echo "saturday-cockpit: no pane named '$arg' (known: $(manifest_names))" >&2
                return 1
            fi
            if [ "$(printf '%s\n' "$slots" | wc -l)" -gt 1 ]; then
                echo "saturday-cockpit: '$arg' matches slots $(printf '%s' "$slots" | tr '\n' ' ')— use the slot number" >&2
                return 1
            fi
            slot="$slots" ;;
        *) slot="$arg" ;;
    esac
    if [ -n "$slot" ]; then
        pane="$(backend_pane_details | awk -F'\t' -v s="$slot" '$2 == s { print $1; exit }')"
        if [ -z "$pane" ]; then
            echo "saturday-cockpit: no live pane in slot $slot" >&2
            return 1
        fi
    fi
    if ! backend_pane_details | cut -f1 | grep -qxF -- "$pane"; then
        echo "saturday-cockpit: $pane isn't a pane in '$SESSION'" >&2
        return 1
    fi
    printf '%s\n' "$pane"
}

# pane_detail <pane_id> prints that pane's backend_pane_details row.
pane_detail() {
    backend_pane_details | awk -F'\t' -v p="$1" '$1 == p { print; exit }'
}

# restart_pane respawns a pane's claude in place, resuming the session it
# holds right now, with the flags it was launched with. The session id
# comes from the pane's own Claude Code record (exact), then the manifest,
# then the newest transcript for its dir (a guess, and said so). A pane
# restarting itself can't wait for its own respawn — the respawn kills the
# process asking for it — so that case is handed to a detached shell that
# waits COCKPIT_RESTART_DELAY seconds (default 5) for the current turn to
# finish first.
restart_pane() {
    local pane="$1" slot pid kind dir cmd sid res full
    # manifest_refresh (run by the caller) has tagged every slotted pane
    IFS=$'\t' read -r _ slot pid _ _ _ _ kind dir cmd sid <<< "$(pane_detail "$pane")"
    if [ "$slot" = "-" ] || [ "$kind" = "-" ] || [ "$kind" = strip ]; then
        echo "saturday-cockpit: $pane isn't a cockpit pane (no slot or launch record)" >&2
        return 1
    fi
    dir="$(undash "$dir")"; cmd="$(undash "$cmd")"; sid="$(undash "$sid")"
    if [ -z "$dir" ] || [ -z "$cmd" ]; then
        echo "saturday-cockpit: don't know how $pane was launched (dir '$dir', cmd '$cmd')" >&2
        return 1
    fi
    local run="$cmd"
    if [ "$kind" != watch ]; then
        if [ "$pid" != "-" ] && res="$(session_field "$pid" sessionId)" && [ -n "$res" ]; then
            sid="$res"
        elif [ -z "$sid" ] && res="$(resolve_last_session "$dir")"; then
            sid="${res%%$'\t'*}"
            echo "saturday-cockpit: $pane has no live session record; guessing the newest transcript for $dir ($sid)" >&2
        fi
        if [ -z "$sid" ]; then
            echo "saturday-cockpit: no session to resume for $pane ($dir) — refusing to restart it as a fresh one" >&2
            return 1
        fi
        run="$cmd --resume $sid"
    fi
    full="cd '$dir' && exec $run"
    tag_pane "$pane" "$kind" "$dir" "$run"

    if [ "$pane" = "${TMUX_PANE:-}" ]; then
        local statedir log script
        statedir="$(dirname "$(manifest_path)")"
        mkdir -p "$statedir"
        log="$statedir/restart-${pane#%}.log"
        script="$statedir/restart-${pane#%}.sh"
        printf 'sleep %q\ntmux respawn-pane -k -t %q %q\n' \
            "${COCKPIT_RESTART_DELAY:-5}" "$pane" "$full" > "$script"
        manifest_refresh
        setsid nohup bash "$script" > "$log" 2>&1 < /dev/null &
        echo "saturday-cockpit: this pane ($pane) restarts in ${COCKPIT_RESTART_DELAY:-5}s, resuming $sid. If it doesn't come back, see $log."
    else
        backend_respawn "$pane" "$full"
        wait_pane_settled "$pane" 10 ||
            echo "saturday-cockpit: warning: $pane didn't settle within 10s" >&2
        if backend_pane_dead "$pane"; then
            echo "saturday-cockpit: $pane died right after restart — its command was: $full" >&2
            return 1
        fi
        manifest_refresh
        echo "saturday-cockpit: restarted slot $slot ($pane)${sid:+, resuming $sid}."
    fi
    if [ "$kind" != watch ]; then
        echo "  Background tasks and Monitor watches from before the restart are gone; re-arm any that matter."
    fi
}

# add_watch_pane <name> <dir> <new-window 0|1> <cmd> puts a non-claude
# command (a log tail, a live viz) into the cockpit without moving anyone's
# focus: split-window/new-window both select the new pane unless given -d,
# and a raw `tmux new-window` into cc-cockpit yanked the user off a live
# grid more than once (notes/COCKPIT-NONCLAUDE-LAUNCH-STEALS-FOCUS.md). It
# splits into the cockpit's first window like `add` does, unless asked for
# a window of its own or that window already holds COCKPIT_WATCH_MAX_PANES
# (default 9) panes. A zoomed window is re-zoomed on the same pane, since a
# split un-zooms it. The pane gets a slot (Alt+N reaches it) and a
# manifest row, so `--resume` brings it back and `restart` re-runs it.
# stage never mistakes it for a project's pane: mayor finds panes by the
# claude pid in their process tree (inject.FindTmuxPane), not by cwd.
add_watch_pane() {
    local name="$1" dir="$2" own_window="$3" cmd="$4" win count zoomed active pane where
    win="$SESSION:^"
    count="$(tmux list-panes -t "$win" | wc -l)"
    if [ "$own_window" -eq 1 ] || [ "$count" -ge "${COCKPIT_WATCH_MAX_PANES:-9}" ]; then
        pane="$(tmux new-window -d -t "$SESSION" -n "$name" -c "$dir" -P -F '#{pane_id}' "$cmd")"
        where="its own window '$name'"
        [ "$own_window" -eq 1 ] || where="$where (the cockpit window already has $count panes)"
    else
        zoomed="$(tmux display-message -p -t "$win" '#{window_zoomed_flag}')"
        active="$(tmux display-message -p -t "$win" '#{pane_id}')"
        pane="$(tmux split-window -d -t "$win" -c "$dir" -P -F '#{pane_id}' "$cmd")"
        tmux select-layout -t "$win" "$LAYOUT" >/dev/null
        [ "$zoomed" = "1" ] && tmux resize-pane -Z -t "$active"
        where="the cockpit window"
    fi
    backend_set_slot "$pane" "$(next_free_slot)"
    backend_set_title "$pane" "$name"
    tag_pane "$pane" watch "$dir" "$cmd"
    echo "saturday-cockpit: watching '$name' in $where, slot $(backend_get_slot "$pane") ($pane). Focus unchanged."
}

# pane_state prints what a pane is doing, for status: dead (exited, held by
# remain-on-exit), suspended (ctrl+z — claude handles SIGTSTP itself and
# stays in state S, so only its on-screen notice gives it away; `wake`
# clears it), watch for a watch pane, else the session record's own status
# (busy, idle, ...), else "-".
pane_state() {
    local pane="$1" pid="$2" dead="$3" kind="$4" v
    if [ "$dead" = "1" ]; then echo dead; return; fi
    if backend_capture "$pane" | grep -v '^[[:space:]]*$' | tail -3 |
        grep -q 'Claude Code has been suspended'; then
        echo suspended; return
    fi
    if [ "$kind" = "watch" ]; then echo watch; return; fi
    if [ "$pid" != "-" ] && v="$(session_field "$pid" status)" && [ -n "$v" ]; then
        echo "$v"; return
    fi
    echo "-"
}

# cockpit_status: one line per pane, slot first and sorted by it — the slot
# is the number Alt+N jumps to, and the number a person means by "pane 4".
# tmux's own pane index is unrelated to it and deliberately not shown.
cockpit_status() {
    manifest_refresh
    local pane slot pid dead start cwd title kind dir cmd sid name label details
    local -A names=() sids=()
    while IFS=$'\t' read -r slot _ _ _ name _ sid; do
        names[$slot]="$name"; sids[$slot]="$sid"
    done < <(manifest_rows)
    details="$(backend_pane_details)"
    {
        printf 'SLOT\tNAME\tSTATE\tDIR\tSESSION\tPANE\n'
        while IFS=$'\t' read -r pane slot pid dead start cwd title kind dir cmd sid; do
            [ "$dir" = "-" ] && dir="$cwd"
            # the manifest's sid is the live session record's, fresher than the tag
            sid="$(undash "${sids[$slot]:-$sid}")"
            label="$(undash "$title")"
            [ -z "$label" ] && label="$(undash "${names[$slot]:-}")"
            [ -z "$label" ] && [ "$dir" != "-" ] && label="$(basename "$dir")"
            printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$slot" "${label:--}" \
                "$(pane_state "$pane" "$pid" "$dead" "$kind")" "${dir/#$HOME/\~}" "${sid:0:8}" "$pane"
        done < <(awk -F'\t' '$2 != "-"' <<< "$details" | sort -t$'\t' -k2,2n
                 awk -F'\t' '$2 == "-"' <<< "$details")
    } | column -t -s $'\t'
}

# stub_cmd_for <dir> <role> <inst> <delay_ms> prints the placeholder command
# for a --boot pane: the dir's basename as the label, plus the instrument
# role/subsystem and start delay that make each pane a DIFFERENT instrument
# (one cockpit of varied instruments, not N copies of one animation — see
# the stub's own header for the roster and its provenance). Roles and
# subsystems cycle by peripheral index from the two arrays below; when the
# cycles drift out of phase past 4 peripherals (a COMMS nav display), that
# reads as variety, not error.
BOOT_ROLES=(gauge scope radar strip)
BOOT_INSTS=(SERVOS COMMS OPTICS REACTOR MANIPULATOR)
stub_cmd_for() {
    local dir="$1" role="$2" instname="$3" delay="$4"
    local stub="${COCKPIT_BOOT_STUB:-}"
    if [ -z "$stub" ]; then
        if command -v saturday-cockpit-boot-stub >/dev/null 2>&1; then
            stub=saturday-cockpit-boot-stub
        else
            # not on PATH (this script is usually run by full path, and the
            # stub isn't symlinked into any bin dir) — fall back to the
            # sibling file next to this script. Without this fallback every
            # placeholder pane died instantly on `exec: not found` and
            # remain-on-exit + the respawn loop silently papered over it.
            stub="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)/saturday-cockpit-boot-stub"
        fi
    fi
    local cmd label
    label="$(basename "$dir")"
    cmd="'$stub' '$label' --role $role --delay $delay"
    if [ -n "$instname" ]; then cmd="$cmd --inst $instname"; fi
    if [ "$boot_fast" -eq 1 ]; then cmd="$cmd --fast"; fi
    echo "$cmd"
}

# boot_edge_split <dir> <stub-cmd> <peripheral-index>: --boot's peripheral
# entry. The pane arrives as a sliver ANCHORED TO A WINDOW EDGE
# (split-window -f/-b, cycling bottom → right → top → left) and grows
# inward through eased resize steps — the terminal analog of the hatch
# closing in from the screen edges — then STAYS PUT as part of the ritual's
# hero-ring layout: center pane large, small instrument panes ringing it (a
# 3x3 with the border rows/columns shrunk). No tiled snap here; the working
# layout returns only after the reveal. Growth pacing matches stage's
# shipped smoothdamp envelope (saturday-stage/main.go, 180ms/50ms tau). A
# 5th+ peripheral subdivides the ring pane already holding its edge, so the
# ring grows toward the full 8-slot border instead of stacking strips.
# Echoes the new pane id — creation order != pane-index order once -b
# splits exist, so callers must NOT re-derive it via list-panes|tail.
BOOT_GROW_STEPS=(190 360 600 780 910 1000)  # eased growth curve, permille
boot_edge_split() {
    local dir="$1" cmd="$2" edge=$(( $3 % 4 ))
    local pane flags axis whole target pm sz ring gaxis start
    case "$edge" in
        0) flags="-f -v";    axis=y ;;   # bottom edge, grows up
        1) flags="-f -h";    axis=x ;;   # right edge, grows left
        2) flags="-f -v -b"; axis=y ;;   # top edge, grows down
        3) flags="-f -h -b"; axis=x ;;   # left edge, grows right
    esac
    ring="${boot_ring[$edge]:-}"
    if [ -n "$ring" ]; then
        # this edge's ring slot is taken — halve that pane instead
        if [ "$axis" = y ]; then
            whole="$(tmux display-message -p -t "$ring" '#{pane_width}')"
            target=$(( whole / 2 )); [ "$target" -lt 10 ] && target=10
            pane="$(tmux split-window -h -t "$ring" -l 6 -P -F '#{pane_id}' "cd '$dir' && exec $cmd")"
            gaxis=x; start=6
        else
            whole="$(tmux display-message -p -t "$ring" '#{pane_height}')"
            target=$(( whole / 2 )); [ "$target" -lt 4 ] && target=4
            pane="$(tmux split-window -v -t "$ring" -l 3 -P -F '#{pane_id}' "cd '$dir' && exec $cmd")"
            gaxis=y; start=3
        fi
    else
        if [ "$axis" = y ]; then
            pane="$(tmux split-window -t "$SESSION" $flags -l 3 -P -F '#{pane_id}' "cd '$dir' && exec $cmd")"
            whole="$(tmux display-message -p -t "$SESSION" '#{window_height}')"
            target=$(( whole / 5 ))
            [ "$target" -lt 6 ] && target=6; [ "$target" -gt 12 ] && target=12
            gaxis=y; start=3
        else
            pane="$(tmux split-window -t "$SESSION" $flags -l 6 -P -F '#{pane_id}' "cd '$dir' && exec $cmd")"
            whole="$(tmux display-message -p -t "$SESSION" '#{window_width}')"
            target=$(( whole / 5 ))
            [ "$target" -lt 20 ] && target=20; [ "$target" -gt 44 ] && target=44
            gaxis=x; start=6
        fi
        boot_ring[$edge]="$pane"
    fi
    for pm in "${BOOT_GROW_STEPS[@]}"; do
        sz=$(( start + (target - start) * pm / 1000 ))
        tmux resize-pane -t "$pane" "-$gaxis" "$sz" 2>/dev/null || true
        sleep 0.035
    done
    tmux set-option -p -t "$pane" @cockpit_slot "$(next_free_slot)"
    echo "$pane"
}

# Same as add_pane, but the new slot is itself a nested pellicle pair — a
# claude pane with a 3-line status-render strip split above it — instead of
# a bare claude pane. Ported from ~/Documents/pellicle/pellicle-claude's own
# split logic (that script won't do this itself: it detects it's already
# inside tmux and falls back to plain claude, by design, so cockpit has to
# build the pair itself). Coordinated with the pellicle session before
# landing this.
#
# Known rough edge: add_pane's select-layout call for any OTHER dir, later,
# rebalances every pane in the window including this one's 3-line strip
# back to the general grid. pellicle's own Stop-hook resize in
# status-fallback.sh reasserts the right height on that project's next
# turn, so this self-heals rather than staying broken — but there's a
# window where it's wrong. Not fixed here; flagged instead.
add_pane_pellicle() {
    local dir="$1" cmd="${2:-$CLAUDE_CMD}" title="${3:-}"
    local pellicle_dir="${PELLICLE_DIR:-$HOME/Documents/pellicle}"
    if [ ! -x "$pellicle_dir/pellicle-pane-render.sh" ]; then
        echo "saturday-cockpit: --pellicle needs $pellicle_dir/pellicle-pane-render.sh (set PELLICLE_DIR?)" >&2
        return 1
    fi
    if ! command -v watch >/dev/null 2>&1; then
        echo "saturday-cockpit: --pellicle needs 'watch' (procps)." >&2
        return 1
    fi

    local claude_pane_id
    claude_pane_id="$(backend_split "$SESSION" "$dir" "$cmd")"
    backend_set_dir "$claude_pane_id" "$dir"
    [ -n "$title" ] && backend_set_title "$claude_pane_id" "$title"
    backend_set_slot "$claude_pane_id" "$(next_free_slot)"
    tag_pane "$claude_pane_id" pellicle "$dir" "$cmd"

    local watch_cmd
    watch_cmd="watch -n 1 --no-title $(printf '%q' "$pellicle_dir/pellicle-pane-render.sh") $(printf '%q' "$dir")"

    local render_pane_id
    render_pane_id="$(backend_split_strip "$claude_pane_id" "$dir" "$watch_cmd" 3)"
    # no slot and no manifest row: it's part of the pair, restored with it
    backend_set_meta "$render_pane_id" kind strip
    echo "$render_pane_id" > "$dir/.pellicle-pane"

    backend_select_pane "$claude_pane_id"
    backend_select_layout
    LAST_PANE="$claude_pane_id"
}

# Alt+1..9: jump straight to the pane holding slot N, zoomed full-screen —
# press the same number again to toggle back to the tiled overview. Alt+0
# always forces the overview. bind_hotkeys/apply_border_format are thin
# wrappers now — the mechanism (tmux: a run-shell filter resolved fresh at
# *keypress* time; ttmux: concrete bindings recomputed and pushed by this
# script every time it's called, since ttmux has no per-keypress shell-out
# at all) lives in bin/cockpit-backend-${COCKPIT_BACKEND}.sh, whose own
# header comments carry the full rationale for each. Call sites unchanged
# from before the backend split: initial launch and every `add`.
bind_hotkeys() {
    ensure_pane_slots
    backend_bind_hotkeys
}

# apply_border_format (re)asserts the pane-border rendering. Called at
# initial launch and again from `add`, so a cockpit already running under
# an older script version picks up border-format changes live, without a
# full restart.
apply_border_format() {
    backend_apply_border_format
}

case "${1:-}" in
    stop|down|kill)
        if backend_has_session; then
            # last look at the live panes (session ids, names) before
            # they're gone, so a later --resume can restore them
            manifest_refresh
            backend_kill_session
            echo "saturday-cockpit: session killed."
        else
            echo "saturday-cockpit: no session running."
        fi
        exit 0
        ;;
    status)
        if backend_has_session; then
            # ttmux backend: no pid or cwd, so STATE and SESSION are thinner
            # there. See backend_pane_details in cockpit-backend-ttmux.sh.
            cockpit_status
        else
            echo "saturday-cockpit: not running."
            exit 1
        fi
        exit 0
        ;;
    restart|wake)
        sub="$1"; shift
        require_tmux_backend "$sub"
        if ! backend_has_session; then
            echo "saturday-cockpit: no session running." >&2
            exit 1
        fi
        if [ "$#" -gt 1 ]; then
            echo "usage: saturday-cockpit $sub [<slot> | <name> | <%pane>]   (default: the pane this runs in)" >&2
            exit 2
        fi
        manifest_refresh
        pane="$(resolve_target "${1:-}")" || exit 1
        if [ "$sub" = restart ]; then
            restart_pane "$pane" || exit 1
        else
            # ctrl+z in a cockpit pane: claude prints "Run `fg`", but the
            # pane has no shell to run it in. SIGCONT is what fg would send.
            IFS=$'\t' read -r _ slot pid _ <<< "$(pane_detail "$pane")"
            kill -CONT "$pid"
            echo "saturday-cockpit: sent SIGCONT to slot $slot ($pane, pid $pid)."
        fi
        exit 0
        ;;
    watch)
        shift
        require_tmux_backend watch
        if ! backend_has_session; then
            echo "saturday-cockpit: no session running." >&2
            exit 1
        fi
        wname=""; own_window=0; wdir="$PWD"
        while [ "$#" -gt 0 ]; do
            case "$1" in
                --name) wname="${2:?--name needs a value}"; shift 2 ;;
                --window) own_window=1; shift ;;
                --dir) wdir="${2:?--dir needs a value}"; shift 2 ;;
                --) shift; break ;;
                --*) echo "saturday-cockpit: unknown flag: $1" >&2; exit 2 ;;
                *) break ;;
            esac
        done
        if [ "$#" -lt 1 ]; then
            echo "usage: saturday-cockpit watch [--name <name>] [--window] [--dir <dir>] [--] <cmd> [<arg> ...]" >&2
            exit 2
        fi
        if ! wdir="$(abs_dir "$wdir")"; then
            echo "saturday-cockpit: not a directory: $wdir" >&2
            exit 1
        fi
        wname="${wname:-$(basename "$1")}"
        wcmd="$(printf '%q ' "$@")"
        manifest_refresh
        add_watch_pane "$wname" "$wdir" "$own_window" "${wcmd% }"
        bind_hotkeys
        manifest_refresh
        exit 0
        ;;
    add)
        shift
        if ! backend_has_session; then
            echo "saturday-cockpit: no session running. Start one with: saturday-cockpit <dir> [<dir> ...]" >&2
            exit 1
        fi
        bind_hotkeys
        apply_border_format
        pellicle=0
        resume=0
        resume_picker=0
        allow_fresh=0
        yolo=0
        rc=0
        title=""
        while [ "$#" -gt 0 ]; do
            case "$1" in
                --pellicle) pellicle=1; shift ;;
                --resume|--resume-last) resume=1; shift ;;
                --allow-fresh) allow_fresh=1; shift ;;
                --resume-picker) resume_picker=1; shift ;;
                --dangerously-skip-permissions) yolo=1; shift ;;
                --remote-control|--rc) rc=1; shift ;;
                --title)
                    if [ "$#" -lt 2 ]; then
                        echo "saturday-cockpit: --title needs a value" >&2
                        exit 2
                    fi
                    title="$2"; shift 2 ;;
                --) shift; break ;;
                --*)
                    echo "saturday-cockpit: unknown flag: $1" >&2
                    exit 2
                    ;;
                *) break ;;
            esac
        done
        if [ "$resume" -eq 1 ] && [ "$resume_picker" -eq 1 ]; then
            echo "saturday-cockpit: --resume and --resume-picker are mutually exclusive" >&2
            exit 2
        fi
        if [ "$resume_picker" -eq 1 ]; then
            CLAUDE_CMD="$CLAUDE_CMD --resume"
        fi
        if [ "$yolo" -eq 1 ]; then
            CLAUDE_CMD="$CLAUDE_CMD --dangerously-skip-permissions"
        fi
        if [ "$rc" -eq 1 ]; then
            CLAUDE_CMD="$CLAUDE_CMD --remote-control"
        fi
        reuse_flags=$(( yolo == 0 && rc == 0 && resume_picker == 0 && CLAUDE_CMD_EXPLICIT == 0 ))
        if [ "$#" -lt 1 ]; then
            echo "usage: saturday-cockpit add [--pellicle] [--resume [--allow-fresh] | --resume-picker] [--dangerously-skip-permissions] [--remote-control|--rc] [--title <name>] <dir> [<dir> ...]" >&2
            exit 2
        fi
        if [ -n "$title" ] && [ "$#" -gt 1 ]; then
            echo "saturday-cockpit: --title only applies to a single <dir> — add panes one at a time to title each" >&2
            exit 2
        fi
        manifest_refresh
        plan_launches "$@"
        n="$#"; i=0
        for idx in "${!LAUNCH_DIRS[@]}"; do
            i=$((i + 1))
            d="${LAUNCH_DIRS[$idx]}"; dcmd="${LAUNCH_CMDS[$idx]}"
            dtitle="${title:-${LAUNCH_TITLES[$idx]}}"
            if [ "$pellicle" -eq 1 ]; then
                add_pane_pellicle "$d" "$dcmd" "$dtitle"
            else
                add_pane "$d" "$dcmd" "$dtitle"
            fi
            # Only wait between launches, not after the last one — see
            # wait_pane_settled's comment for why this matters.
            if [ "$i" -lt "$n" ]; then
                wait_pane_settled "$LAST_PANE" 10 ||
                    echo "saturday-cockpit: warning: $d's pane didn't settle within 10s, continuing anyway" >&2
            fi
        done
        # Rebind hotkeys/labels for the topology this batch just created.
        # tmux's bind_hotkeys is a static, idempotent re-bind either way
        # (harmless extra call); ttmux's needs this — its bindings are
        # concrete pane ids computed *now*, not resolved live at keypress
        # time, so a multi-dir `add` batch needs one more rebind after all
        # of it lands, not just the one already at the top of this case arm.
        bind_hotkeys
        apply_border_format
        total="$(backend_pane_count)"
        manifest_refresh
        echo "saturday-cockpit: added $# pane(s), $total total."
        print_launch_summary
        exit 0
        ;;
esac

backend_check_not_nested

# Reattach an existing cockpit rather than rebuild it.
if backend_has_session; then
    backend_attach
fi

# --resume/--resume-picker/--dangerously-skip-permissions apply to CLAUDE_CMD
# for the whole initial batch, same as they do in `add`. --pellicle isn't
# accepted here:
# the first pane is built via `new-session`, not `split-window`, so it needs
# its own pane-creation path that doesn't exist yet — launch plain, then
# `add --pellicle` once the session is up.
resume=0
resume_picker=0
allow_fresh=0
restore_watch=()
yolo=0
rc=0
boot=0
boot_fast=0
while [ "$#" -gt 0 ]; do
    case "$1" in
        --resume|--resume-last) resume=1; shift ;;
        --allow-fresh) allow_fresh=1; shift ;;
        --resume-picker) resume_picker=1; shift ;;
        --dangerously-skip-permissions) yolo=1; shift ;;
        --remote-control|--rc) rc=1; shift ;;
        --boot)
            boot=1; shift
            # `--boot fast` = original-SB ~1s snap pacing (a dir literally
            # named "fast" would need --boot ./fast, acceptable corner)
            if [ "${1:-}" = "fast" ]; then boot_fast=1; shift; fi
            ;;
        --pellicle)
            echo "saturday-cockpit: --pellicle only works with 'add' — launch plain, then: saturday-cockpit add --pellicle <dir>" >&2
            exit 2
            ;;
        --) shift; break ;;
        --*)
            echo "saturday-cockpit: unknown flag: $1" >&2
            exit 2
            ;;
        *) break ;;
    esac
done
if [ "$resume" -eq 1 ] && [ "$resume_picker" -eq 1 ]; then
    echo "saturday-cockpit: --resume and --resume-picker are mutually exclusive" >&2
    exit 2
fi
if [ "$resume_picker" -eq 1 ]; then
    CLAUDE_CMD="$CLAUDE_CMD --resume"
fi
if [ "$yolo" -eq 1 ]; then
    CLAUDE_CMD="$CLAUDE_CMD --dangerously-skip-permissions"
fi
if [ "$rc" -eq 1 ]; then
    CLAUDE_CMD="$CLAUDE_CMD --remote-control"
fi
reuse_flags=$(( yolo == 0 && rc == 0 && resume_picker == 0 && CLAUDE_CMD_EXPLICIT == 0 ))

# --boot (Steel Battalion) is built entirely on respawn-pane, remain-on-exit
# + #{pane_dead} polling, and a custom-pane-option sync latch — none of
# which exist in ttmux (see cockpit-backend-ttmux.sh's header).
# Refuse cleanly here, before any of boot's raw tmux calls below run,
# rather than attempting a silently-degraded version.
if [ "$boot" -eq 1 ] && [ "$COCKPIT_BACKEND" = ttmux ]; then
    echo "saturday-cockpit: --boot needs the tmux backend (COCKPIT_BACKEND=tmux) — not supported under ttmux." >&2
    exit 2
fi

if [ "$#" -lt 1 ]; then
    # No dirs given. If a session is already up, reattach — same idiom
    # saturday-stack uses for its own bare invocation — rather than making
    # "how do I get back in" require remembering a dir list or a raw tmux
    # command.
    if backend_has_session; then
        backend_attach
    fi
    # `--resume` alone restores the last cockpit from its manifest, in slot
    # order: every claude pane with its own last session, flags and title
    # (PLAN_SLOTS pins each to its own row, so two panes in one dir stay
    # two sessions). Pellicle pairs come back as plain panes (the initial
    # launch has no pellicle path; see --pellicle below). Watch panes come
    # back after the build, under tmux only.
    if [ "$resume" -eq 1 ]; then
        mapfile -t restore_watch < <(manifest_rows | awk -F'\t' '$2 == "watch"')
        mapfile -t restore_dirs < <(manifest_rows | awk -F'\t' '$2 == "claude" || $2 == "pellicle" { print $3 }')
        mapfile -t PLAN_SLOTS < <(manifest_rows | awk -F'\t' '$2 == "claude" || $2 == "pellicle" { print $1 }')
        if [ "${#restore_dirs[@]}" -gt 0 ]; then
            echo "saturday-cockpit: restoring ${#restore_dirs[@]} pane(s) from $(manifest_path)"
            set -- "${restore_dirs[@]}"
        fi
        if [ "${#restore_watch[@]}" -gt 0 ] && [ "$COCKPIT_BACKEND" != tmux ]; then
            echo "saturday-cockpit: skipping ${#restore_watch[@]} watch pane(s) — watch needs the tmux backend" >&2
            restore_watch=()
        fi
    fi
fi
if [ "$#" -lt 1 ]; then
    echo "usage: saturday-cockpit [--resume [--allow-fresh] | --resume-picker] [--dangerously-skip-permissions] [--remote-control|--rc] <dir> [<dir> ...]" >&2
    echo "       saturday-cockpit add [--pellicle] [--resume [--allow-fresh] | --resume-picker] [--dangerously-skip-permissions] [--remote-control|--rc] <dir> [<dir> ...]" >&2
    echo "       saturday-cockpit stop|status" >&2
    exit 2
fi

# Resolve every dir (and every --resume) up front so we don't build a
# half-cockpit. From here on "$@" holds the absolute dirs, and
# LAUNCH_CMDS[k] is the command for the k-th of them.
plan_launches "$@"
set -- "${LAUNCH_DIRS[@]}"

# First pane = first dir. This is also the "addressed" pane in --boot mode —
# the only existing signal for primary in this script (structurally distinct
# via new-session, tmux's default-focused pane after it).
first="$1"; shift
firstcmd="${LAUNCH_CMDS[0]}"

if [ "$boot" -eq 1 ]; then
    # remain-on-exit must be set BEFORE the first placeholder exists, not
    # after (apply_border_format sets it later, at the very end) — if the
    # stub script exits early for any reason before this lands, tmux would
    # otherwise close the pane immediately and invalidate its captured id.
    #
    # The addressed pane is the center display (--role main) and lights
    # LAST: its dark hold spans the whole assembly estimate. 810ms/pane =
    # 350 stagger + 210 grow + ~250 real tmux round-trip overhead
    # (measured live: nominal 560ms/pane runs ~800ms) — without the
    # overhead term main's checklist starts before the last peripheral's
    # test does.
    prim_delay=$(( $# * 810 + 500 ))
    # Size the detached session to the launching terminal (fallback for
    # headless callers) — a detached new-session defaults to 80x24, which
    # would make the ritual compute its geometry against a window nobody
    # ever sees; sized to the real terminal, attaching mid-boot from
    # another pane/terminal is seamless (the stubs re-layout on WINCH).
    if [ -t 1 ]; then
        boot_w="$( (tput cols) 2>/dev/null || echo 220 )"
        boot_h="$( (tput lines) 2>/dev/null || echo 50 )"
    else
        boot_w=220; boot_h=50
    fi
    firstpane="$(tmux new-session -d -s "$SESSION" -n "cockpit" -x "$boot_w" -y "$boot_h" -P -F '#{pane_id}' \
        "cd '$first' && exec $(stub_cmd_for "$first" main "" "$prim_delay")")"
    tmux set-option -t "$SESSION" remain-on-exit on
else
    firstpane="$(backend_new_session "$first" "$firstcmd")"
fi
if [ -n "${LAUNCH_TITLES[0]}" ]; then backend_set_title "$firstpane" "${LAUNCH_TITLES[0]}"; fi
tag_pane "$firstpane" claude "$first" "$firstcmd"
bind_hotkeys

# Remaining dirs → one split each. Re-balance after every split so tmux always
# has room for the next pane. Staggered via wait_pane_settled — see its
# comment above for why. The pane new-session just launched is a `claude`
# startup too, so if there's at least one more dir queued, wait on it before
# the first split — otherwise that split races the exact same way a second
# add_pane call would.
#
# --boot mode skips every wait_pane_settled call in this section: that race
# is specifically about two real `claude` processes racing each other's
# startup identity bookkeeping (see wait_pane_settled's comment above), and
# these placeholder panes run the boot-stub script, not claude, so the race
# can't occur — instrument panels instead assemble on their own ~350ms
# stagger (boot_edge_split + the sleep below), which is the ritual's
# panel-by-panel beat, not a settle-wait. Real commands were already
# resolved by plan_launches (LAUNCH_CMDS) and are only exec'd later, in
# the respawn-stagger loop, where the real settle-wait protection is still
# very much needed and still applied (with a shorter timeout).
if [ "$boot" -eq 0 ] && [ "$#" -gt 0 ]; then
    wait_pane_settled "$firstpane" 10 ||
        echo "saturday-cockpit: warning: $first's pane didn't settle within 10s, continuing anyway" >&2
fi
n="$#"; i=0
boot_dirs=(); boot_cmds=(); boot_pane_ids=()
declare -A boot_ring=()   # edge index → first ring pane holding that edge
for d in "$@"; do
    i=$((i + 1))
    if [ "$boot" -eq 1 ]; then
        idx=$(( i - 1 ))
        brole="${BOOT_ROLES[$(( idx % ${#BOOT_ROLES[@]} ))]}"
        binst="${BOOT_INSTS[$(( idx % ${#BOOT_INSTS[@]} ))]}"
        # 450ms base delay covers the pane's own grow window (content drawn
        # into a sliver is clipped for good); the jitter keeps sibling
        # animations off phase-lock.
        newpane="$(boot_edge_split "$d" \
            "$(stub_cmd_for "$d" "$brole" "$binst" "$(( 450 + (idx % 3) * 130 ))")" "$idx")"
        boot_dirs+=("$d")
        boot_cmds+=("${LAUNCH_CMDS[$i]}")
        boot_pane_ids+=("$newpane")
        if [ -n "${LAUNCH_TITLES[$i]}" ]; then backend_set_title "$newpane" "${LAUNCH_TITLES[$i]}"; fi
        tag_pane "$newpane" claude "$d" "${LAUNCH_CMDS[$i]}"
        if [ "$i" -lt "$n" ]; then sleep 0.35; fi   # panel-by-panel stagger
    else
        add_pane "$d" "${LAUNCH_CMDS[$i]}" "${LAUNCH_TITLES[$i]}"
        if [ "$i" -lt "$n" ]; then
            wait_pane_settled "$LAST_PANE" 10 ||
                echo "saturday-cockpit: warning: $d's pane didn't settle within 10s, continuing anyway" >&2
        fi
    fi
done

# Keep dead panes readable; show per-pane titles (basenames, or a custom
# --title) along the top border so the cockpit is legible and stage's title
# marker has a home. --boot keeps its hero-ring geometry through the reveal
# (the working layout returns after the addressed pane's respawn below); the
# normal path balances immediately, as always.
if [ "$boot" -eq 0 ]; then
    # Same reason as `add`'s own extra rebind: tmux's bind_hotkeys is a
    # static, idempotent re-bind regardless of when it runs, but the one
    # call before this loop (right after the first pane's creation) is
    # already stale for ttmux by the time later dirs have their own panes —
    # its bindings are concrete pane ids computed at call time, not
    # resolved live at keypress time.
    bind_hotkeys
fi
apply_border_format
if [ "$boot" -eq 0 ]; then
    backend_select_layout
fi

# --boot's reveal: layout is already settled above, so nothing resizes during
# this loop — respawn-pane swaps a pane's running command in place. Order:
# non-addressed panes first (argv order), the addressed pane (first dir)
# last, each gated on wait_pane_settled so a real `claude` respawn still gets
# the same startup-identity protection add_pane's callers get — just with a
# shorter timeout than the default 10s, since N non-addressed panes each
# capable of timing out before the addressed pane's respawn even starts
# would otherwise risk 30-50s before the "primary settles last" payoff.
if [ "$boot" -eq 1 ]; then
    for idx in "${!boot_dirs[@]}"; do
        d="${boot_dirs[$idx]}"; cmd="${boot_cmds[$idx]}"; pane="${boot_pane_ids[$idx]}"
        tmux respawn-pane -k -t "$pane" "cd '$d' && exec $cmd"
        wait_pane_settled "$pane" 5 ||
            echo "saturday-cockpit: warning: $d's pane didn't settle within 5s, continuing anyway" >&2
    done
    # Hold the addressed respawn until the center display's arc finishes
    # (the stub latches @boot_main_done on its pane at WORK-confirm) — on a
    # small cockpit with fast-settling claudes the respawn otherwise lands
    # ~6s into a ~10s arc and cuts it mid-checklist (observed live, 3-dir
    # run). Bounded: a dead or wedged stub costs at most the deadline. On
    # big cockpits the non-addressed respawns already outlast the arc, so
    # the latch is set before we get here and this loop exits immediately.
    boot_main_deadline=$(( SECONDS + 12 ))
    while [ "$SECONDS" -lt "$boot_main_deadline" ]; do
        if [ "$(tmux show-options -pqv -t "$firstpane" @boot_main_done 2>/dev/null)" = "1" ]; then
            break
        fi
        if [ "$(tmux display-message -p -t "$firstpane" '#{pane_dead}' 2>/dev/null)" = "1" ]; then
            break
        fi
        sleep 0.3
    done
    # ritual over: hand the hero-ring back to the working layout the rest of
    # the tooling (stage tiling, M-0, add's re-balance) assumes — BEFORE the
    # addressed respawn, not after. The stub still running in $firstpane is
    # resize-safe (frame_gate/resize_hold already handle a WINCH mid-draw),
    # but claude isn't, so respawning it into the ring-shaped slot and only
    # then flattening the layout would force a real resize on a freshly-
    # started claude for no reason — this way it only ever renders at its
    # true final size. Note: an asciinema before/after comparison showed
    # this reorder does NOT meaningfully change claude's ~1.3s post-respawn
    # render settle — that appears to be ordinary claude cold-start
    # rendering (auth/project-load/progressive TUI paint), not a resize
    # artifact this script can fix. Kept anyway: it removes a genuinely
    # redundant resize regardless of whether it's visually perceptible.
    tmux select-layout -t "$SESSION" "$LAYOUT" >/dev/null
    tmux respawn-pane -k -t "$firstpane" "cd '$first' && exec $firstcmd"
    wait_pane_settled "$firstpane" 5 ||
        echo "saturday-cockpit: warning: $first's pane didn't settle within 5s, continuing anyway" >&2
fi

echo "saturday-cockpit: '$SESSION' up with $(($# + 1)) panes ($LAYOUT)."
echo "  Alt+1..9 jump-and-zoom to a pane (press again to un-zoom), Alt+0 forces the overview."
echo "  stage drives zoom/tile on inject when mayor runs with --stage-zoom / --stage-tile."
print_launch_summary
for row in "${restore_watch[@]}"; do
    IFS=$'\t' read -r _ _ wdir wname _ wcmd _ <<< "$row"
    add_watch_pane "$(undash "$wname")" "$wdir" 0 "$(undash "$wcmd")"
done
manifest_refresh

if [ -t 1 ]; then
    backend_attach
else
    echo "  (no TTY — attach with: $COCKPIT_BACKEND attach -t $SESSION)"
fi
